<!DOCTYPE html>
<html lang="{{@site.locale}}" class="read-theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    {{!-- Open Graph / Social --}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{@site.title}}">
    <meta property="og:title" content="{{meta_title}}">
    {{#if @site.cover_image}}
    <meta property="og:image" content="{{img_url @site.cover_image size="xl"}}">
    {{/if}}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{meta_title}}">

    {{!-- Canonical --}}
    <link rel="canonical" href="{{url absolute="true"}}">

    {{!-- Google Fonts: Literary Pairing --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    {{!-- Theme CSS --}}
    <link rel="stylesheet" href="{{asset "css/read.css"}}">



    {{ghost_head}}
</head>
<body class="{{body_class}}">

    {{!-- Page Progress Bar --}}
    <div class="progress-bar" id="progress-bar"></div>

    {{!-- Preloader --}}
    <div class="preloader" id="preloader">
        <div class="preloader-inner">
            <div class="preloader-logo-wrap">
                {{#get "posts" filter="tag:hash-custom-logo" limit="1" as |logo_post|}}
                    {{#if logo_post}}
                        {{#foreach logo_post}}
                            <img src="{{img_url feature_image}}" alt="READ Logo" class="preloader-logo-img" width="90" height="90">
                        {{/foreach}}
                    {{else}}
                        <img src="{{#if @site.logo}}{{@site.logo}}{{else}}{{asset "img/read-logo.png"}}{{/if}}" alt="READ Logo" class="preloader-logo-img" width="90" height="90">
                    {{/if}}
                {{/get}}
                <div class="preloader-badge-divider"></div>
                {{#get "posts" filter="tag:hash-silver-jubilee" limit="1" as |jubilee_post|}}
                    {{#if jubilee_post}}
                        {{#foreach jubilee_post}}
                            <img src="{{img_url feature_image}}" alt="Silver Jubilee" class="preloader-logo-jubilee" width="70" height="70">
                        {{/foreach}}
                    {{else}}
                        <img src="{{asset "img/silver_jubilee.png"}}" alt="Silver Jubilee" class="preloader-logo-jubilee" width="70" height="70">
                    {{/if}}
                {{/get}}
            </div>
            <div class="preloader-tagline">Rights Education and Development Centre</div>
        </div>
    </div>

    {{!-- Site Header --}}
    <header class="site-header" id="site-header">
        <div class="header-inner">
            {{!-- Decorative top accent line --}}
            <div class="header-accent-line"></div>

            <div class="header-content">
                {{!-- Logo --}}
                <a href="{{@site.url}}" class="site-logo" aria-label="{{@site.title}} Home" id="site-logo-link">
                    <div class="site-logo-glow"></div>
                    {{#get "posts" filter="tag:hash-custom-logo" limit="1" as |logo_post|}}
                        {{#if logo_post}}
                            {{#foreach logo_post}}
                                <img src="{{img_url feature_image}}" alt="READ – Rights Education and Development Centre" class="site-logo-img" width="52" height="52">
                            {{/foreach}}
                        {{else}}
                            <img src="{{#if @site.logo}}{{@site.logo}}{{else}}{{asset "img/read-logo.png"}}{{/if}}" alt="READ – Rights Education and Development Centre" class="site-logo-img" width="52" height="52">
                        {{/if}}
                    {{/get}}
                    <div class="logo-badge-divider"></div>
                    {{#get "posts" filter="tag:hash-silver-jubilee" limit="1" as |jubilee_post|}}
                        {{#if jubilee_post}}
                            {{#foreach jubilee_post}}
                                <img src="{{img_url feature_image}}" alt="Silver Jubilee" class="site-logo-jubilee" width="36" height="36">
                            {{/foreach}}
                        {{else}}
                            <img src="{{asset "img/silver_jubilee.png"}}" alt="Silver Jubilee" class="site-logo-jubilee" width="36" height="36">
                        {{/if}}
                    {{/get}}
                </a>

                {{!-- Center Navigation --}}
                <nav class="site-nav" id="site-nav">
                    {{navigation}}
                </nav>

                {{!-- Right Actions --}}
                <div class="header-actions">
                    <a href="/donate-us/" class="header-donate-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        <span>Donate</span>
                    </a>
                    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </div>
        </div>

        {{!-- Mobile Menu --}}
        <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
            <div class="mobile-menu-inner">
                {{navigation}}
                <a href="/donate-us/" class="btn-primary-read btn-full">Donate to READ</a>
            </div>
        </div>
    </header>

    {{!-- Main Content --}}
    <main class="site-main">
        {{{body}}}
    </main>

    {{!-- Partners Showcase --}}
    {{> "partners-marquee"}}

    {{!-- Footer --}}
    <footer class="site-footer">
        <div class="footer-ornament">
            <span>✦</span>
            <span>✦</span>
            <span>✦</span>
        </div>

        <div class="footer-inner">
            <div class="footer-brand">
                <a href="{{@site.url}}" class="footer-logo">
                    {{#get "posts" filter="tag:hash-custom-logo" limit="1" as |logo_post|}}
                        {{#if logo_post}}
                            {{#foreach logo_post}}
                                <img src="{{img_url feature_image}}" alt="READ – Rights Education and Development Centre" class="footer-logo-img" width="52" height="52">
                            {{/foreach}}
                        {{else}}
                            <img src="{{#if @site.logo}}{{@site.logo}}{{else}}{{asset "img/read-logo.png"}}{{/if}}" alt="READ – Rights Education and Development Centre" class="footer-logo-img" width="52" height="52">
                        {{/if}}
                    {{/get}}
                </a>
                <p class="footer-tagline">{{@site.description}}</p>
            </div>

            <div class="footer-grid">
                <div class="footer-col">
                    <h4 class="footer-col-title">Explore</h4>
                    {{navigation}}
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="footer-rule"></div>
            <div class="footer-bottom-inner">
                <p class="footer-copy">&copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.</p>
                <div class="footer-social">
                    {{#if @site.secondary_navigation}}
                        {{#foreach @site.secondary_navigation}}
                            <a href="{{url}}" class="social-link dynamic-footer-social" target="_blank" rel="noopener" aria-label="{{label}}" data-label="{{label}}"></a>
                        {{/foreach}}
                    {{else}}
                        {{#if @site.twitter}}
                        <a href="https://twitter.com/{{@site.twitter}}" class="social-link" aria-label="Twitter" target="_blank" rel="noopener">
                            <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        {{/if}}
                        {{#if @site.facebook}}
                        <a href="https://facebook.com/{{@site.facebook}}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener">
                            <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                        {{/if}}
                    {{/if}}
                </div>
                <div class="footer-legal">
                    <a href="/privacy/">Privacy</a>
                    <span>·</span>
                    <a href="/terms/">Terms</a>
                </div>
            </div>
        </div>
    </footer>

    {{!-- Theme JS --}}
    <script src="{{asset "js/read.js"}}"></script>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const footerSocials = document.querySelectorAll('.dynamic-footer-social');
        const icons = {
            facebook: `<svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
            linkedin: `<svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
            instagram: `<svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
            twitter: `<svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.401-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
            x: `<svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.401-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
            youtube: `<svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.163a3.003 3.003 0 00-2.11-2.11C19.53 3.545 12 3.545 12 3.545s-7.53 0-9.388.508a3.003 3.003 0 00-2.11 2.11C0 8.022 0 12 0 12s0 3.978.502 5.837a3.003 3.003 0 002.11 2.11c1.858.507 9.388.507 9.388.507s7.53 0 9.388-.507a3.003 3.003 0 002.11-2.11C24 15.978 24 12 24 12s0-3.978-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`
        };

        footerSocials.forEach(link => {
            const label = (link.getAttribute('data-label') || '').toLowerCase().trim();
            const href = (link.getAttribute('href') || '').toLowerCase();
            let type = 'default';

            if (label.includes('facebook') || href.includes('facebook.com')) {
                type = 'facebook';
            } else if (label.includes('linkedin') || href.includes('linkedin.com')) {
                type = 'linkedin';
            } else if (label.includes('instagram') || href.includes('instagram.com')) {
                type = 'instagram';
            } else if (label.includes('twitter') || href.includes('twitter.com') || label.includes('x.com') || href.includes('x.com')) {
                type = 'twitter';
            } else if (label.includes('youtube') || href.includes('youtube.com')) {
                type = 'youtube';
            }

            if (type !== 'default') {
                link.innerHTML = icons[type];
            } else {
                link.innerHTML = `<svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-3.939a4 4 0 00-5.656 0l-1.1 1.1a4 4 0 105.656 5.656l4-4a4 4 0 000-5.656"/></svg>`;
            }
        });
    });
    </script>

    {{ghost_foot}}
</body>
</html>
