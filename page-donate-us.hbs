{{!< default}}

{{#post}}
<div class="donate-page">

    <section class="donate-support-section">
        <div class="donate-support-bg">
            <div class="donate-support-orb donate-support-orb-1"></div>
            <div class="donate-support-orb donate-support-orb-2"></div>
        </div>
        <div class="donate-support-container">
            <div class="donate-support-header" data-animate="fade-up">
                <div class="donate-support-label">Make a Difference</div>
                <h1 class="donate-support-title">{{#if title}}{{title}}{{else}}Where Your <em>Support Goes</em>{{/if}}</h1>
                <p class="donate-support-subtitle">
                    {{#if custom_excerpt}}{{custom_excerpt}}{{else}}Every contribution you make is channelled directly into programs that uplift the most vulnerable communities across Tamil Nadu.{{/if}}
                </p>
            </div>

            {{#if content}}
            <div class="donate-page-content gh-content" style="margin-bottom: 40px; color: var(--clr-text-muted); font-size: 1.05rem; line-height: 1.7; text-align: center;">
                {{content}}
            </div>
            {{/if}}

            <div class="donate-support-grid" data-animate="fade-up" data-delay="100">

                <div class="donate-support-item">
                    <div class="donate-support-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg></div>
                    <div class="donate-support-text">
                        <h3>Scholarship for Tribal Children</h3>
                        <p>Enabling tribal children to access quality education by providing financial support for fees, books, and school essentials.</p>
                    </div>
                </div>

                <div class="donate-support-item">
                    <div class="donate-support-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></div>
                    <div class="donate-support-text">
                        <h3>Counselling &amp; Mental Health Services</h3>
                        <p>Providing professional counselling and emotional support to individuals and families in distress across migrant and tribal communities.</p>
                    </div>
                </div>

                <div class="donate-support-item">
                    <div class="donate-support-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></div>
                    <div class="donate-support-text">
                        <h3>Tribal Community Development</h3>
                        <p>Strengthening tribal villages through infrastructure, solar irrigation, bore wells, and sustainable livelihood programs.</p>
                    </div>
                </div>

                <div class="donate-support-item">
                    <div class="donate-support-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></div>
                    <div class="donate-support-text">
                        <h3>Women Safety &amp; POSH Awareness Programs</h3>
                        <p>Conducting awareness sessions on the POSH Act, women's rights, and workplace safety to create safer environments for women workers.</p>
                    </div>
                </div>

                <div class="donate-support-item">
                    <div class="donate-support-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                    <div class="donate-support-text">
                        <h3>Migrant Worker Protection Initiatives</h3>
                        <p>Supporting migrant workers and their families with legal aid, health services, child education, and welfare assistance.</p>
                    </div>
                </div>

                <div class="donate-support-item">
                    <div class="donate-support-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg></div>
                    <div class="donate-support-text">
                        <h3>Livelihood &amp; Rehabilitation Support</h3>
                        <p>Empowering women and marginalised communities through SHG formation, skill training, micro-enterprise grants, and income generation programs.</p>
                    </div>
                </div>

                <div class="donate-support-item">
                    <div class="donate-support-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
                    <div class="donate-support-text">
                        <h3>Emergency &amp; Community Welfare Interventions</h3>
                        <p>Responding to urgent community needs with immediate relief, nutrition support, and essential welfare services during crises.</p>
                    </div>
                </div>

            </div>

            {{!-- Donation Methods --}}
            <div class="donate-methods" data-animate="fade-up" data-delay="150">
                <div class="donate-methods-header">
                    <h2 class="donate-methods-title">Choose Your <em>Donation Method</em></h2>
                    <p class="donate-methods-subtitle">All donations to READ are tax-exempt under Section 80G of the Income Tax Act.</p>
                </div>

                <div class="donate-methods-grid">
                    {{!-- Bank Transfer Card --}}
                    <div class="donate-method-card bank-transfer-card">
                        <div class="donate-method-badge">Direct Transfer</div>
                        <h3 class="donate-method-card-title">Bank Account Details</h3>
                        
                        <div class="bank-details-list">
                            <div class="bank-detail-item">
                                <span class="bank-detail-label">Account Name</span>
                                <span class="bank-detail-val">Rights Education and Development Centre (READ)</span>
                            </div>
                            <div class="bank-detail-item">
                                <span class="bank-detail-label">Account Number</span>
                                <span class="bank-detail-val">3047220002307 <span class="copy-hint" onclick="navigator.clipboard.writeText('3047220002307'); alert('Account number copied!');">(Copy)</span></span>
                            </div>
                            <div class="bank-detail-item">
                                <span class="bank-detail-label">Bank Name</span>
                                <span class="bank-detail-val">State Bank of India</span>
                            </div>
                            <div class="bank-detail-item">
                                <span class="bank-detail-label">Branch</span>
                                <span class="bank-detail-val">Sathyamangalam</span>
                            </div>
                            <div class="bank-detail-item">
                                <span class="bank-detail-label">IFSC Code</span>
                                <span class="bank-detail-val">SBIN0001234 <span class="copy-hint" onclick="navigator.clipboard.writeText('SBIN0001234'); alert('IFSC code copied!');">(Copy)</span></span>
                            </div>
                            <div class="bank-detail-item">
                                <span class="bank-detail-label">Account Type</span>
                                <span class="bank-detail-val">Savings Account</span>
                            </div>
                        </div>
                    </div>

                    {{!-- UPI & QR Code Card --}}
                    <div class="donate-method-card upi-qr-card">
                        <div class="donate-method-badge">UPI &amp; QR Code</div>
                        <h3 class="donate-method-card-title">Scan to Donate</h3>
                        
                        <div class="qr-code-wrapper">
                            <div class="qr-code-placeholder">
                                <div class="qr-code-border">
                                    <div class="qr-code-inner-box">
                                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--clr-gold); opacity: 0.5;"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M7 17h.01M17 7h.01M7 7h.01M17 17h.01"/></svg>
                                        <span class="qr-code-text">UPI QR Code</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="upi-id-box">
                            <span class="upi-id-label">UPI ID:</span>
                            <span class="upi-id-val">readsuryamsw@okaxis</span>
                            <button class="upi-copy-btn" onclick="navigator.clipboard.writeText('readsuryamsw@okaxis'); alert('UPI ID copied!');" aria-label="Copy UPI ID">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m-6 4h6m-3-3v6"/></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="donate-tax-info">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <p>After making a donation, please share the transaction receipt along with your PAN details to <strong>readsuryamsw@gmail.com</strong> so we can issue your tax exemption certificate (Form 10BE).</p>
                </div>
            </div>
        </div>
    </section>

</div>

<style>
.donate-page {
    min-height: 100vh;
    background: var(--clr-bg, #080d11);
}

.donate-support-section {
    position: relative;
    padding: 100px 0 120px;
    overflow: hidden;
}

.donate-support-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
}

.donate-support-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.18;
}

.donate-support-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #38bdf8, transparent 70%);
    top: -100px;
    left: -150px;
}

.donate-support-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #6366f1, transparent 70%);
    bottom: -80px;
    right: -100px;
}

.donate-support-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
}

.donate-support-header {
    text-align: center;
    margin-bottom: 64px;
}

.donate-support-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 999px;
    padding: 6px 18px;
    margin-bottom: 20px;
}

.donate-support-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    color: #f1f5f9;
    line-height: 1.15;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
}

.donate-support-title em {
    font-style: normal;
    color: #38bdf8;
}

.donate-support-subtitle {
    font-size: 1.05rem;
    color: #94a3b8;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.7;
}

.donate-support-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.donate-support-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    padding: 28px 24px;
    transition: background 0.3s, border-color 0.3s, transform 0.3s;
}

.donate-support-item:hover {
    background: rgba(56,189,248,0.06);
    border-color: rgba(56,189,248,0.2);
    transform: translateY(-3px);
}

.donate-support-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: rgba(56,189,248,0.1);
    border: 1px solid rgba(56,189,248,0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
}

.donate-support-icon svg {
    width: 22px;
    height: 22px;
}

.donate-support-text h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0 0 8px;
    line-height: 1.3;
}

.donate-support-text p {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.65;
    margin: 0;
}

/* Last item spans full width if odd count */
.donate-support-item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    max-width: 460px;
    margin: 0 auto;
}

@media (max-width: 640px) {
    .donate-support-grid {
        grid-template-columns: 1fr;
    }
    .donate-support-item:last-child:nth-child(odd) {
        grid-column: auto;
        max-width: none;
    }
    .donate-support-section {
        padding: 64px 0 80px;
    }
}
</style>

{{/post}}
