                                        <span class="social-icon-placeholder"></span>
                                        <span>{{label}}</span>
                                    </a>
                                {{/foreach}}
                            {{else}}
                                {{!-- Static Fallbacks --}}
                                <a href="https://www.facebook.com/share/18r4cyttcW/?mibextid=wwXIfr" class="social-pill facebook-pill" target="_blank" rel="noopener" aria-label="Facebook">
                                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                                    <span>Facebook</span>
                                </a>
                                <a href="https://www.linkedin.com/in/read-tn-346489217?utm_source=share_via&utm_content=profile&utm_medium=member_ios" class="social-pill linkedin-pill" target="_blank" rel="noopener" aria-label="LinkedIn">
                                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                                    <span>LinkedIn</span>
                                </a>
                                <a href="https://www.instagram.com/read_organisation?igsh=MWc0ZjF2NzhvcWMxMA==" class="social-pill instagram-pill" target="_blank" rel="noopener" aria-label="Instagram">
                                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                                    <span>Instagram</span>
                                </a>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- Volunteer Section ── --}}
    <section class="contact-volunteer-section" id="volunteer-section">
        <div class="volunteer-container" data-animate="fade-up">
            <div class="volunteer-header">
                <div class="volunteer-badge">
                    <span class="volunteer-sparkle">✦</span>
                    <span>Become a Volunteer</span>
                    <span class="volunteer-sparkle">✦</span>
                </div>
                <h2 class="volunteer-title">Join Our <em>Movement</em></h2>
                <p class="volunteer-desc">Support rights, education, and development across Tamil Nadu. Share your details below and we will get in touch with you.</p>
            </div>

            <div class="volunteer-card">
                <form id="volunteer-form" class="volunteer-form">
                    {{!-- FormSubmit AJAX Endpoint --}}
                    <input type="text" name="_honey" style="display:none">
                    <input type="hidden" name="_subject" value="New Volunteer Registration - READ">
                    <input type="hidden" name="_captcha" value="false">

                    <div class="volunteer-form-grid">
                        <div class="form-group">
                            <label for="volunteer-name" class="form-label">Full Name *</label>
                            <input type="text" id="volunteer-name" name="name" class="form-input" placeholder="e.g. Anjali Devi" required>
                        </div>
                        <div class="form-group">
                            <label for="volunteer-email" class="form-label">Email Address *</label>
                            <input type="email" id="volunteer-email" name="email" class="form-input" placeholder="e.g. anjali@example.com" required>
                        </div>
                        <div class="form-group">
                            <label for="volunteer-phone" class="form-label">Phone Number *</label>
                            <input type="tel" id="volunteer-phone" name="phone" class="form-input" placeholder="e.g. +91 98765 43210" required>
                        </div>
                        <div class="form-group">
                            <label for="volunteer-interest" class="form-label">Area of Interest *</label>
                            <select id="volunteer-interest" name="interest" class="form-select" required>
                                <option value="" disabled selected>Select an option</option>
                                <option value="Education Support">Education & Literacy</option>
                                <option value="Rights Advocacy">Rights & Advocacy</option>
                                <option value="Tribal Development">Tribal Villages Empowerment</option>
                                <option value="Livelihood & Skills">Livelihood & Skills Training</option>
                                <option value="Health Campaigns">Health & Welfare Campaigns</option>
                                <option value="Other">Other (General Support)</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group full-width" style="margin-top: var(--space-md);">
                        <label for="volunteer-message" class="form-label">Why do you want to volunteer with READ? (Optional)</label>
                        <textarea id="volunteer-message" name="message" class="form-textarea" placeholder="Tell us a little bit about yourself, your skills, or your motivation..."></textarea>
                    </div>

                    <div class="volunteer-form-actions">
                        <button type="submit" class="volunteer-submit-btn" id="volunteer-submit-btn">
                            <span class="btn-text">Submit Application</span>
                            <span class="btn-loading" style="display:none;">
                                <svg class="spinner" viewBox="0 0 50 50">
                                    <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                                </svg>
                                Sending...
                            </span>
                        </button>
                    </div>
                </form>

                {{!-- Success card --}}
                <div class="volunteer-success-card" id="volunteer-success" style="display:none;">
                    <div class="success-icon-wrap">
                        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <h3>Application Submitted!</h3>
                    <p>Thank you for expressing interest in volunteering with READ. We have received your application and will contact you via email or phone soon.</p>
                    <button type="button" class="volunteer-btn-reset" onclick="resetVolunteerForm()">Submit Another Response</button>
                </div>
            </div>
        </div>
    </section>

    {{!-- Map / Location Banner --}}
    <section class="contact-map-section" data-animate="fade-up">
        <div class="contact-map-inner">
            <div class="contact-map-label">
                <span class="contact-map-pin"><svg width="14" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                <span>Head Office: Kombupallam, Sathyamangalam</span>
            </div>
            <div class="contact-map-embed">
                <iframe
                    src="https://maps.google.com/maps?q=Rights%20Education%20and%20Development%20Centre%20Kombupallam%20Sathyamangalam&t=&z=15&ie=UTF8&iwloc=&output=embed"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="READ Centre Location">
                </iframe>
            </div>
            <div class="contact-map-btn-wrap">
                <a href="https://www.google.com/maps/dir/?api=1&destination=Rights+Education+and+Development+Centre+Sathyamangalam" 
                   target="_blank" 
                   rel="noopener" 
                   class="contact-map-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                    <span>Navigate to Head Office (Sathyamangalam)</span>
                </a>
            </div>
        </div>
    </section>

