    };
    
    socialPills.forEach(pill => {
        const label = (pill.getAttribute('data-label') || '').toLowerCase().trim();
        const href = (pill.getAttribute('href') || '').toLowerCase();
        
        let type = 'default';
        if (label.includes('facebook') || href.includes('facebook.com')) {
            type = 'facebook';
        } else if (label.includes('linkedin') || href.includes('linkedin.com')) {
            type = 'linkedin';
        } else if (label.includes('instagram') || href.includes('instagram.com')) {
            type = 'instagram';
        } else if (label.includes('twitter') || href.includes('twitter.com') || label.includes('x.com') || href.includes('x.com')) {
            type = 'twitter';
        } else if (label.includes('youtube') || href.includes('youtube.com')) {
            type = 'youtube';
        }
        
        if (type !== 'default') {
            pill.classList.add(type + '-pill');
            const placeholder = pill.querySelector('.social-icon-placeholder');
            if (placeholder) {
                placeholder.innerHTML = icons[type];
            }
        } else {
            // Default generic link icon
            const placeholder = pill.querySelector('.social-icon-placeholder');
            if (placeholder) {
                placeholder.innerHTML = `<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-3.939a4 4 0 00-5.656 0l-1.1 1.1a4 4 0 105.656 5.656l4-4a4 4 0 000-5.656"/></svg>`;
            }
        }
    });

    // Dynamic Phone and Email from @custom.contact_details
    {{#if @custom.contact_details}}
    (function() {
        const rawContact = "{{@custom.contact_details}}".trim();
        if (!rawContact) return;

        const parts = rawContact.split(',').map(p => p.trim());
        const phone = parts[0];
        const email = parts[1];

        if (phone) {
            const phoneLinkEl = document.getElementById('contact-phone-link');
            const phoneValueEl = document.getElementById('contact-phone-value');
            if (phoneLinkEl) phoneLinkEl.setAttribute('href', 'tel:' + phone.replace(/\s+/g, ''));
            if (phoneValueEl) phoneValueEl.textContent = phone;
        }

        if (email) {
            const emailLinkEl = document.getElementById('contact-email-link');
            const emailValueEl = document.getElementById('contact-email-value');
            if (emailLinkEl) emailLinkEl.setAttribute('href', 'mailto:' + email);
            if (emailValueEl) emailValueEl.textContent = email;
        }
    })();
    {{/if}}

    // Volunteer Form Submission Handler
    const volunteerForm = document.getElementById('volunteer-form');
    const volunteerSuccess = document.getElementById('volunteer-success');
    const submitBtn = document.getElementById('volunteer-submit-btn');

    if (volunteerForm && submitBtn) {
        volunteerForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const btnText = submitBtn.querySelector('.btn-text');
            const btnLoading = submitBtn.querySelector('.btn-loading');
            
            if (btnText && btnLoading) {
                btnText.style.display = 'none';
                btnLoading.style.display = 'inline-flex';
                submitBtn.disabled = true;
            }
            
            const formData = new FormData(volunteerForm);
            const payload = {};
            formData.forEach((value, key) => {
                payload[key] = value;
            });
            
            fetch("https://formsubmit.co/ajax/read.erode2000@gmail.com", {
                method: "POST",
                headers: { 
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify(payload)
            })
            .then(response => {
                if (response.ok) {
                    volunteerForm.style.display = 'none';
                    if (volunteerSuccess) volunteerSuccess.style.display = 'block';
                } else {
                    alert("Something went wrong. Please try again or email us directly at read.erode2000@gmail.com.");
                    btnText.style.display = 'inline';
                    btnLoading.style.display = 'none';
                    submitBtn.disabled = false;
                }
            })
            .catch(error => {
                console.error("Error submitting volunteer form:", error);
                alert("Connection error. Please check your network and try again.");
                btnText.style.display = 'inline';
                btnLoading.style.display = 'none';
                submitBtn.disabled = false;
            });
        });
    }
});

function resetVolunteerForm() {
    const form = document.getElementById('volunteer-form');
    const success = document.getElementById('volunteer-success');
    const submitBtn = document.getElementById('volunteer-submit-btn');
    if (form && success && submitBtn) {
        form.reset();
        form.style.display = 'block';
        success.style.display = 'none';
        
        const btnText = submitBtn.querySelector('.btn-text');
        const btnLoading = submitBtn.querySelector('.btn-loading');
        if (btnText && btnLoading) {
            btnText.style.display = 'inline';
            btnLoading.style.display = 'none';
            submitBtn.disabled = false;
        }
    }
}
</script>
</div>

