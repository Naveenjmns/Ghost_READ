{{!< default}}

{{#post}}
<div class="contact-page">

    {{!-- Hero Banner --}}
    <section class="contact-hero">
        {{#if feature_image}}
        <div class="contact-hero-bg" style="background-image: url('{{img_url feature_image size="xl"}}');"></div>
        {{else}}
        <div class="contact-hero-bg"></div>
        {{/if}}
        <div class="contact-hero-inner">
            <div class="contact-hero-badge" data-animate="fade-up">
                <span class="contact-hero-dot"></span>
                <span>Get In Touch · READ Centre</span>
            </div>

            <div class="contact-hero-kicker" data-animate="fade-up" data-delay="60">
                <span class="contact-hero-kicker-line"></span>
                <span class="contact-hero-kicker-text">We're always open to new connections</span>
                <span class="contact-hero-kicker-line"></span>
            </div>

            <h1 class="contact-hero-title" data-animate="fade-up" data-delay="120">
                {{#if title}}{{title}}{{else}}Contact <em>Us</em>{{/if}}
            </h1>

            <p class="contact-hero-desc" data-animate="fade-up" data-delay="200">
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}Reach out to the READ team. Whether you're a <strong>donor, partner, volunteer,</strong> or <em>community member</em> — we'd love to hear from you.{{/if}}
            </p>

            <div class="contact-hero-pills" data-animate="fade-up" data-delay="280">
                <span class="contact-hero-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    Donor
                </span>
                <span class="contact-hero-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Partner
                </span>
                <span class="contact-hero-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    Volunteer
                </span>
                <span class="contact-hero-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Community
                </span>
                <span class="contact-hero-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                    CSR / NGO
                </span>
            </div>
        </div>
    </section>

    {{!-- Main Contact Layout --}}
    <section class="contact-main">
        <div class="contact-container">
            
            {{!-- Left Column: Our Offices --}}
            <div class="contact-section-group" data-animate="fade-up">
                <h2 class="contact-group-title">Our Offices</h2>
                
                {{#get "posts" filter="tag:hash-contact-office" limit="10" order="published_at asc" as |office_posts|}}
                    {{#if office_posts}}
                        {{#foreach office_posts}}
                            <div class="contact-info-card" data-animate="fade-up" data-delay-index="{{@index}}">
                                <div class="contact-info-icon-wrap">
                                    <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                                </div>
                                <div class="contact-info-body">
                                    <h3 class="contact-info-title">{{title}}</h3>
                                    <div class="contact-info-text">
                                        {{content}}
                                    </div>
                                </div>
                            </div>
                        {{/foreach}}
                    {{else}}
                        {{!-- Head Office Card --}}
                        <div class="contact-info-card" data-animate="fade-up" data-delay="100">
                            <div class="contact-info-icon-wrap">
                                <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                            </div>
                            <div class="contact-info-body">
                                <h3 class="contact-info-title">Head Office</h3>
                                <p class="contact-info-text">
                                    <strong>Rights Education and Development Centre - READ</strong><br>
                                    195, MGR Nagar, Bannari Main Road<br>
                                    Kombupallam, Sathyamangalam<br>
                                    Erode District – 638401<br>
                                    Tamil Nadu, India.
                                </p>
                            </div>
                        </div>

                        {{!-- Project Office (Tiruppur) Card --}}
                        <div class="contact-info-card" data-animate="fade-up" data-delay="150">
                            <div class="contact-info-icon-wrap">
                                <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                            </div>
                            <div class="contact-info-body">
                                <h3 class="contact-info-title">Project Office - Tiruppur</h3>
                                <p class="contact-info-text">
                                    <strong>Rights Education and Development Centre - (READ)</strong><br>
                                    No: 4, 2nd street, Ram Nagar<br>
                                    Near Hamshavinayagar Temple<br>
                                    Tiruppur – 641602
                                </p>
                            </div>
                        </div>

                        {{!-- Project Office (Kadambur) Card --}}
                        <div class="contact-info-card" data-animate="fade-up" data-delay="200">
                            <div class="contact-info-icon-wrap">
                                <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                            </div>
                            <div class="contact-info-body">
                                <h3 class="contact-info-title">Project Office - Kadambur</h3>
                                <p class="contact-info-text">
                                    <strong>Rights Education and Development Centre - READ</strong><br>
                                    No: 8, High School Road<br>
                                    Back to State bank<br>
                                    Kadambur, Sathyamangalam<br>
                                    Erode District, Tamil Nadu.
                                </p>
                            </div>
                        </div>
                    {{/if}}
                {{/get}}
            </div>

            {{!-- Right Column: Direct Contact --}}
            <div class="contact-section-group" data-animate="fade-up" data-delay="100">
                <h2 class="contact-group-title">Direct Contact</h2>
                
                {{!-- Phone Card --}}
                <a href="tel:+914295224313" class="contact-action-card" data-animate="fade-up" data-delay="150" id="contact-phone-link">
                    <div class="contact-action-icon-wrap">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </div>
                    <div class="contact-action-body">
                        <h3 class="contact-action-title">Call Us</h3>
                        <span class="contact-action-value" id="contact-phone-value">+91 4295 224313</span>
                        <span class="contact-action-note">Mon – Sat, 9am – 6pm IST</span>
                    </div>
                    <div class="contact-action-arrow">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                </a>

                {{!-- Email Card --}}
                <a href="mailto:readsuryamsw@gmail.com" class="contact-action-card" data-animate="fade-up" data-delay="200" id="contact-email-link">
                    <div class="contact-action-icon-wrap">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </div>
                    <div class="contact-action-body">
                        <h3 class="contact-action-title">Email Us</h3>
                        <span class="contact-action-value" id="contact-email-value">readsuryamsw@gmail.com</span>
                        <span class="contact-action-note">We usually reply within 24 hours</span>
                    </div>
                    <div class="contact-action-arrow">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                </a>

                {{!-- Social Card --}}
                <div class="contact-action-card contact-social-action-card" data-animate="fade-up" data-delay="250">
                    <div class="contact-action-body">
                        <h3 class="contact-action-title" style="margin-bottom: var(--space-sm); text-align: center;">Connect With Us</h3>
                        <div class="contact-social-pills">
