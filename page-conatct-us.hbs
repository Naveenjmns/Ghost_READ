{{!< default}}

{{#post}}
<div class="contact-page">

    {{!-- Hero Banner --}}
    <section class="contact-hero">
        {{#if feature_image}}
        <div class="contact-hero-bg" style="background-image: url('{{img_url feature_image size="xl"}}');"></div>
        {{else}}
        <div class="contact-hero-bg"></div>
        {{/if}}
        <div class="contact-hero-inner">
            <div class="contact-hero-badge" data-animate="fade-up">
                <span class="contact-hero-dot"></span>
                <span>Get In Touch</span>
            </div>
            <h1 class="contact-hero-title" data-animate="fade-up" data-delay="100">
                {{#if title}}{{title}}{{else}}Contact <em>Us</em>{{/if}}
            </h1>
            <p class="contact-hero-desc" data-animate="fade-up" data-delay="200">
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}Reach out to the READ team. Whether you're a donor, partner, volunteer, or community member — we'd love to hear from you.{{/if}}
            </p>
        </div>
    </section>

    {{!-- Main Contact Layout --}}
    <section class="contact-main">
        <div class="contact-container">

            {{!-- Contact Form Card --}}
            <div class="contact-form-card" data-animate="fade-up">
                <div class="contact-form-header">
                    <div class="contact-form-icon"></div>
                    <h2 class="contact-form-title">Send Us a Message</h2>
                    {{#if content}}
                        <div class="contact-form-content gh-content" style="font-size: 0.95rem; color: #94a3b8; line-height: 1.6; margin-top: 10px;">
                            {{content}}
                        </div>
                    {{else}}
                        <p class="contact-form-subtitle">Fill out the form and we'll get back to you within 2–3 business days.</p>
                    {{/if}}
                </div>

                <form class="contact-form" id="contact-form" novalidate>
                    <div class="contact-form-row">
                        <div class="contact-field-group">
                            <label class="contact-label" for="contact-name">Full Name</label>
                            <input class="contact-input" type="text" id="contact-name" name="name" placeholder="e.g. Karthik Rajan" required>
                        </div>
                        <div class="contact-field-group">
                            <label class="contact-label" for="contact-email">Email Address</label>
                            <input class="contact-input" type="email" id="contact-email" name="email" placeholder="you@example.com" required>
                        </div>
                    </div>

                    <div class="contact-field-group">
                        <label class="contact-label" for="contact-subject">Subject</label>
                        <select class="contact-input contact-select" id="contact-subject" name="subject">
                            <option value="" disabled selected>Select a topic…</option>
                            <option value="donation">Donation Enquiry</option>
                            <option value="volunteer">Volunteer / Join Us</option>
                            <option value="csr">CSR Partnership</option>
                            <option value="tribal">Tribal Development Program</option>
                            <option value="posh">POSH / Workplace Safety</option>
                            <option value="media">Media / Press</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div class="contact-field-group">
                        <label class="contact-label" for="contact-message">Your Message</label>
                        <textarea class="contact-input contact-textarea" id="contact-message" name="message" rows="6" placeholder="Tell us how we can help…" required></textarea>
                    </div>

                    <button type="submit" class="contact-submit-btn" id="contact-submit">
                        <span class="contact-submit-text">Send Message</span>
                        <svg class="contact-submit-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                    </button>

                    <div class="contact-success" id="contact-success" style="display:none;">
                        <span></span>
                        <span>Thank you! Your message has been sent. We'll be in touch shortly.</span>
                    </div>
                </form>
            </div>

            {{!-- Info Sidebar --}}
            <aside class="contact-sidebar">

                {{!-- Head Office Card --}}
                <div class="contact-info-card" data-animate="fade-up" data-delay="100">
                    <div class="contact-info-icon-wrap">
                        <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                    </div>
                    <div class="contact-info-body">
                        <h3 class="contact-info-title">Head Office</h3>
                        <p class="contact-info-text">
                            <strong>Rights Education and Development Centre - READ</strong><br>
                            195, MGR Nagar, Bannari Main Road<br>
                            Kombupallam, Sathyamangalam<br>
                            Erode District – 638401<br>
                            Tamil Nadu, India.
                        </p>
                    </div>
                </div>

                {{!-- Project Office (Tiruppur) Card --}}
                <div class="contact-info-card" data-animate="fade-up" data-delay="150">
                    <div class="contact-info-icon-wrap">
                        <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                    </div>
                    <div class="contact-info-body">
                        <h3 class="contact-info-title">Project Office - Tiruppur</h3>
                        <p class="contact-info-text">
                            <strong>Rights Education and Development Centre - (READ)</strong><br>
                            No: 4, 2nd street, Ram Nagar<br>
                            Near Hamshavinayagar Temple<br>
                            Tiruppur – 641602
                        </p>
                    </div>
                </div>

                {{!-- Project Office (Kadambur) Card --}}
                <div class="contact-info-card" data-animate="fade-up" data-delay="200">
                    <div class="contact-info-icon-wrap">
                        <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                    </div>
                    <div class="contact-info-body">
                        <h3 class="contact-info-title">Project Office - Kadambur</h3>
                        <p class="contact-info-text">
                            <strong>Rights Education and Development Centre - READ</strong><br>
                            No: 8, High School Road<br>
                            Back to State bank<br>
                            Kadambur, Sathyamangalam<br>
                            Erode District, Tamil Nadu.
                        </p>
                    </div>
                </div>

                {{!-- Phone Card --}}
                <div class="contact-info-card" data-animate="fade-up" data-delay="250">
                    <div class="contact-info-icon-wrap">
                        <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></span>
                    </div>
                    <div class="contact-info-body">
                        <h3 class="contact-info-title">Phone</h3>
                        <p class="contact-info-text">
                            <a href="tel:+919876543210" class="contact-info-link">+91 98765 43210</a><br>
                            <small class="contact-info-note">Mon – Sat, 9am – 6pm IST</small>
                        </p>
                    </div>
                </div>

                {{!-- Email Card --}}
                <div class="contact-info-card" data-animate="fade-up" data-delay="300">
                    <div class="contact-info-icon-wrap">
                        <span class="contact-info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></span>
                    </div>
                    <div class="contact-info-body">
                        <h3 class="contact-info-title">Email</h3>
                        <p class="contact-info-text">
                            <a href="mailto:info@readcentre.org" class="contact-info-link">info@readcentre.org</a><br>
                            <a href="mailto:donate@readcentre.org" class="contact-info-link">donate@readcentre.org</a>
                        </p>
                    </div>
                </div>

                {{!-- Social Card --}}
                <div class="contact-info-card contact-social-card" data-animate="fade-up" data-delay="400">
                    <h3 class="contact-info-title">Follow Us</h3>
                    <div class="contact-social-links">
                        <a href="https://www.facebook.com/share/18r4cyttcW/?mibextid=wwXIfr" class="contact-social-btn" aria-label="Facebook" target="_blank" rel="noopener">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            <span>Facebook</span>
                        </a>
                        <a href="https://www.linkedin.com/in/read-tn-346489217?utm_source=share_via&utm_content=profile&utm_medium=member_ios" class="contact-social-btn" aria-label="LinkedIn" target="_blank" rel="noopener">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                            <span>LinkedIn</span>
                        </a>
                        <a href="https://www.instagram.com/read_organisation?igsh=MWc0ZjF2NzhvcWMxMA==" class="contact-social-btn" aria-label="Instagram" target="_blank" rel="noopener">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                            <span>Instagram</span>
                        </a>
                    </div>
                </div>

            </aside>
        </div>
    </section>

    {{!-- Map / Location Banner --}}
    <section class="contact-map-section" data-animate="fade-up">
        <div class="contact-map-inner">
            <div class="contact-map-label">
                <span class="contact-map-pin"><svg width="14" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                <span>Head Office: Kombupallam, Sathyamangalam</span>
            </div>
            <div class="contact-map-embed">
                <iframe
                    src="https://maps.google.com/maps?q=Rights%20Education%20and%20Development%20Centre%20Kombupallam%20Sathyamangalam&t=&z=15&ie=UTF8&iwloc=&output=embed"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="READ Centre Location">
                </iframe>
            </div>
            <div class="contact-map-btn-wrap">
                <a href="https://www.google.com/maps/dir/?api=1&destination=Rights+Education+and+Development+Centre+Sathyamangalam" 
                   target="_blank" 
                   rel="noopener" 
                   class="contact-map-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                    <span>Navigate to Head Office (Sathyamangalam)</span>
                </a>
            </div>
        </div>
    </section>

</div>

{{!-- Contact form JS --}}
<script>
(function() {
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('contact-success');
    const submitBtn = document.getElementById('contact-submit');

    if (!form) return;

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.querySelector('.contact-submit-text').textContent = 'Sending…';

        // Simulate a short delay then show success
        setTimeout(function() {
            form.reset();
            successMsg.style.display = 'flex';
            submitBtn.disabled = false;
            submitBtn.querySelector('.contact-submit-text').textContent = 'Send Message';
            setTimeout(function() {
                successMsg.style.display = 'none';
            }, 6000);
        }, 1200);
    });
})();
</script>

{{/post}}
