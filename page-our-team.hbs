{{!< default}}

{{#post}}
<div class="contact-page team-page">
    <div class="template-marker" data-template="page-our-team.hbs" style="display:none;"></div>

    {{!-- Hero Banner using contact hero styles to match theme aesthetics --}}
    <section class="contact-hero">
        {{#if feature_image}}
        <div class="contact-hero-bg" style="background-image: url('{{img_url feature_image size="xl"}}');"></div>
        {{else}}
        <div class="contact-hero-bg"></div>
        {{/if}}
        <div class="contact-hero-inner">
            <div class="contact-hero-badge" data-animate="fade-up">
                <span class="contact-hero-dot"></span>
                <span>Our Team</span>
            </div>
            <h1 class="contact-hero-title" data-animate="fade-up" data-delay="100">
                {{#if title}}{{title}}{{else}}Meet Our <em>Team</em>{{/if}}
            </h1>
            <p class="contact-hero-desc" data-animate="fade-up" data-delay="200">
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}The dedicated people behind Rights Education and Development Centre (READ) working for the empowerment of marginalized communities.{{/if}}
            </p>
        </div>
    </section>

    {{!-- Cards Grid Section --}}
    <section class="team-cards-section" data-animate="fade-up">
        <div class="team-container">
            {{#if content}}
            <div class="team-page-intro gh-content" style="max-width: 800px; margin: 0 auto 50px; color: var(--clr-text-2); font-size: 1.05rem; line-height: 1.7; text-align: center;">
                {{content}}
            </div>
            {{/if}}

            {{#get "posts" filter="tag:board" limit="all" order="published_at asc" include="tags" as |board_members|}}
                {{#get "posts" filter="tag:team" limit="all" order="published_at asc" include="tags" as |team_members|}}
                    
                    {{#if board_members}}
                        <div class="team-section-grid-wrap">
                            <div class="team-section-header">
                                <h2 class="team-section-title">Board Members</h2>
                                <div class="team-scroll-nav">
                                    <button class="scroll-btn prev" onclick="this.closest('.team-section-grid-wrap').querySelector('.team-scroll-container').scrollBy({ left: -322, behavior: 'smooth' })">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                    </button>
                                    <button class="scroll-btn next" onclick="this.closest('.team-section-grid-wrap').querySelector('.team-scroll-container').scrollBy({ left: 322, behavior: 'smooth' })">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                    </button>
                                </div>
                            </div>
                            <p class="team-section-subtitle" data-animate="fade-up">Our governing board provides strategic guidance, administrative oversight, and a shared commitment to steering READ's mission toward lasting social impact.</p>
                            <div class="team-scroll-container">
                                {{#foreach board_members}}
                                <div class="team-card" data-animate="fade-up" style="animation-delay: calc({{@index}} * 60ms);">
                                    <div class="team-avatar-wrap">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="team-avatar-img">
                                        {{else}}
                                            <div class="team-avatar-fallback"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                                        {{/if}}
                                    </div>
                                    <div class="team-card-info">
                                        <h3 class="team-member-name">{{title}}</h3>
                                        <div class="team-member-role">
                                            {{content}}
                                        </div>
                                    </div>
                                </div>
                                {{/foreach}}
                            </div>
                        </div>
                    {{/if}}

                    {{#if team_members}}
                        <div class="team-section-grid-wrap">
                            <div class="team-section-header">
                                <h2 class="team-section-title">Our Team</h2>
                                
                                <div class="team-scroll-nav">
                                    <button class="scroll-btn prev" onclick="this.closest('.team-section-grid-wrap').querySelector('.team-scroll-container').scrollBy({ left: -322, behavior: 'smooth' })">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                    </button>
                                    <button class="scroll-btn next" onclick="this.closest('.team-section-grid-wrap').querySelector('.team-scroll-container').scrollBy({ left: 322, behavior: 'smooth' })">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                    </button>
                                </div>
                            </div>
                            <p class="team-section-subtitle" data-animate="fade-up">READ is supported by social workers, counsellors, trainers, grassroots volunteers, community leaders, resource persons, and development professionals committed to social transformation. Our team works closely with communities through empathy, professionalism, and long-term engagement.</p>
                            <div class="team-scroll-container">
                                {{#foreach team_members}}
                                <div class="team-card" data-animate="fade-up" style="animation-delay: calc({{@index}} * 60ms);">
                                    <div class="team-avatar-wrap">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="team-avatar-img">
                                        {{else}}
                                            <div class="team-avatar-fallback"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                                        {{/if}}
                                    </div>
                                    <div class="team-card-info">
                                        <h3 class="team-member-name">{{title}}</h3>
                                        <div class="team-member-role">
                                            {{content}}
                                        </div>
                                    </div>
                                </div>
                                {{/foreach}}
                            </div>
                        </div>
                    {{/if}}

                    {{#unless board_members}}
                        {{#unless team_members}}
                            <div class="team-empty-state">
                                <div class="team-empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
                                <p class="team-empty-text">No team or board members found. Create posts tagged with <strong>board</strong> or <strong>team</strong>, setting the member name as the title, designation as the content, and photo as the feature image.</p>
                            </div>
                        {{/unless}}
                    {{/unless}}

                {{/get}}
            {{/get}}
        </div>
    </section>

</div>

<style>
.team-container {
    max-width: var(--max-w-wide, 1200px);
    margin: 0 auto;
    padding: 0 24px 100px;
}

.team-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 60px 0 24px;
    border-bottom: 1px solid var(--clr-border, rgba(255, 255, 255, 0.1));
    padding-bottom: 16px;
}

.team-section-title {
    font-family: var(--font-display, "Playfair Display", serif);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--clr-text, #f8fafc);
    margin: 0;
}

.team-section-subtitle {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--clr-text-2, #b4c6d4);
    line-height: 1.6;
    margin: 16px 0 24px;
    max-width: 900px;
}

.team-scroll-nav {
    display: flex;
    gap: 12px;
}

.scroll-btn {
    background: var(--clr-card-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--clr-border, rgba(255, 255, 255, 0.1));
    color: var(--clr-text-2, #94a3b8);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-mid, 0.3s);
}

.scroll-btn:hover {
    background: var(--clr-gold-alpha-10, rgba(56, 189, 248, 0.1));
    border-color: var(--clr-gold, #38bdf8);
    color: var(--clr-gold, #38bdf8);
    transform: scale(1.05);
}

.scroll-btn svg {
    display: block;
}

.team-section-grid-wrap {
    margin-bottom: 60px;
}

.team-section-grid-wrap:last-of-type {
    margin-bottom: 0;
}

.team-scroll-container {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 32px;
    padding: 20px 4px 40px;
    scroll-snap-type: none; /* Disabled for JS slow auto-scroll compatibility */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--clr-gold-alpha-20, rgba(56, 189, 248, 0.2)) transparent;
}

.team-scroll-container.is-paused {
    scroll-snap-type: x mandatory; /* Enabled on hover/touch interactions */
}

.team-scroll-container::-webkit-scrollbar {
    height: 6px;
}

.team-scroll-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
}

.team-scroll-container::-webkit-scrollbar-thumb {
    background: var(--clr-gold-alpha-20, rgba(56, 189, 248, 0.2));
    border-radius: 10px;
    transition: background var(--transition-mid, 0.3s);
}

.team-scroll-container::-webkit-scrollbar-thumb:hover {
    background: var(--clr-gold, #38bdf8);
}

.team-card {
    flex: 0 0 290px;
    scroll-snap-align: start;
    background: var(--clr-card-bg, rgba(255, 255, 255, 0.03));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--clr-border, rgba(255, 255, 255, 0.1));
    border-radius: 20px;
    padding: 40px 24px;
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-mid, 0.3s), border-color var(--transition-mid, 0.3s), box-shadow var(--transition-mid, 0.3s);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.team-card:hover {
    transform: translateY(-6px);
    border-color: var(--clr-gold-alpha-20, rgba(56, 189, 248, 0.2));
    box-shadow: var(--shadow-lg), var(--shadow-gold, 0 0 20px rgba(56, 189, 248, 0.1));
}

.team-avatar-wrap {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    border: 3px solid var(--clr-border-light, rgba(255, 255, 255, 0.15));
    background: var(--clr-bg-2, #0c1219);
    margin-bottom: 24px;
    transition: border-color var(--transition-mid, 0.3s), transform var(--transition-mid, 0.3s);
}

.team-card:hover .team-avatar-wrap {
    border-color: var(--clr-gold, #38bdf8);
    transform: scale(1.05);
}

.team-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.team-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    color: var(--clr-text-3, #475569);
    background: var(--clr-bg-2, #0c1219);
}

.team-card-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
}

.team-member-name {
    font-family: var(--font-display, "Playfair Display", serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--clr-text, #f8fafc);
    margin: 0;
    line-height: 1.3;
}

.team-member-role {
    font-family: var(--font-ui, "Inter", sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--clr-gold, #38bdf8);
    margin: 0;
    line-height: 1.4;
}

/* Format HTML paragraphs outputted by dynamic editor content */
.team-member-role p, .team-member-role div {
    margin: 0;
    display: inline-block;
    padding: 4px 14px;
    background: var(--clr-gold-alpha-10, rgba(56, 189, 248, 0.1));
    border: 1px solid var(--clr-gold-alpha-20, rgba(56, 189, 248, 0.2));
    border-radius: 999px;
    font-family: var(--font-ui, "Inter", sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.team-empty-state {
    text-align: center;
    padding: 60px 24px;
    max-width: 600px;
    margin: 40px auto 0;
    background: var(--clr-card-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--clr-border, rgba(255, 255, 255, 0.1));
    border-radius: 20px;
}

.team-empty-icon {
    font-size: 3rem;
    margin-bottom: 20px;
    color: var(--clr-text-3, #475569);
}

.team-empty-text {
    font-family: var(--font-ui, "Inter", sans-serif);
    font-size: 0.95rem;
    color: var(--clr-text-2, #94a3b8);
    line-height: 1.6;
    margin: 0;
}
</style>

<script>
(function() {
    function initTeamScroll() {
        const containers = document.querySelectorAll('.team-scroll-container');
        containers.forEach(container => {
            let isHovered = false;
            let scrollSpeed = 0.5; // slow scroll speed (pixels per frame)
            let direction = 1; // 1 = forward, -1 = reverse
            
            const section = container.closest('.team-section-grid-wrap');
            const targetElement = section || container;

            targetElement.addEventListener('mouseenter', () => { 
                isHovered = true; 
                container.classList.add('is-paused');
            });
            targetElement.addEventListener('mouseleave', () => { 
                isHovered = false; 
                container.classList.remove('is-paused');
            });
            
            // Also pause on touch devices
            targetElement.addEventListener('touchstart', () => { 
                isHovered = true; 
                container.classList.add('is-paused');
            }, { passive: true });
            targetElement.addEventListener('touchend', () => { 
                isHovered = false; 
                container.classList.remove('is-paused');
            }, { passive: true });
            
            function step() {
                if (!isHovered) {
                    const maxScroll = container.scrollWidth - container.clientWidth;
                    if (maxScroll > 0) {
                        if (container.scrollLeft >= maxScroll - 1 && direction === 1) {
                            direction = -1;
                        } else if (container.scrollLeft <= 1 && direction === -1) {
                            direction = 1;
                        }
                        container.scrollLeft += scrollSpeed * direction;
                    }
                }
                requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTeamScroll);
    } else {
        initTeamScroll();
    }
})();
</script>
{{/post}}
