{{!< default}}

{{#post}}
<div class="stories-page">

    {{!-- ── Hero ─────────────────────────────── --}}
    <section class="stories-hero">
        <div class="stories-hero-bg">
            <div class="stories-hero-orb stories-hero-orb-1"></div>
            <div class="stories-hero-orb stories-hero-orb-2"></div>

            {{!-- Background Slideshow (6 custom uploaded images) --}}
            <div class="hero-slideshow">
                <div class="hero-slide active" style="background-image: url('{{asset "img/stories1.jpeg"}}');"></div>
                <div class="hero-slide" style="background-image: url('{{asset "img/stories2.jpeg"}}');"></div>
                <div class="hero-slide" style="background-image: url('{{asset "img/stories3.png"}}');"></div>
                <div class="hero-slide" style="background-image: url('{{asset "img/stories4.jpeg"}}');"></div>
                <div class="hero-slide" style="background-image: url('{{asset "img/stories5.jpeg"}}');"></div>
                <div class="hero-slide" style="background-image: url('{{asset "img/stories6.jpeg"}}');"></div>
            </div>
            <div class="hero-slideshow-overlay"></div>
        </div>
        <div class="stories-hero-inner">
            <div class="stories-hero-badge" data-animate="fade-up">
                <span class="stories-hero-sparkle"></span>
                <span>Real People · Real Change</span>
            </div>
            <h1 class="stories-hero-title" data-animate="fade-up" data-delay="100">
                {{#if title}}{{title}}{{else}}Impact <em>Stories</em>{{/if}}
            </h1>
            <p class="stories-hero-desc" data-animate="fade-up" data-delay="200">
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}Every story here is a life transformed. From tribal villages to urban settlements, these are real experiences of communities empowered through READ's programs across Tamil Nadu.{{/if}}
            </p>
            {{#if content}}
            <div class="stories-hero-content gh-content" style="max-width: 800px; margin: 40px auto 0; text-align: center; color: rgba(255,255,255,0.7); font-size: 1.05rem; line-height: 1.7;">
                {{content}}
            </div>
            {{/if}}
        </div>
    </section>

    {{!-- ── Dynamic Category Filter ────────────── --}}
    <section class="stories-filter-bar">
        <div class="stories-container">
            <div class="stories-filters" id="stories-filters">
                <button class="stories-filter-btn stories-filter-btn--active" data-filter="all">
                    All Stories
                </button>
                {{#get "tags" filter="slug:[education,tribal,women,health,posh,migration,livelihood]" limit="20" order="name asc"}}
                    {{#foreach tags}}
                    <button class="stories-filter-btn" data-filter="{{slug}}">
                        {{name}}
                    </button>
                    {{/foreach}}
                {{/get}}
            </div>
        </div>
    </section>

    {{!-- ── Story Cards Grid (fully dynamic) ─────── --}}
    <section class="stories-grid-section">
        <div class="stories-container">
            {{#get "posts" filter="tag:story" limit="50" include="tags,authors" order="featured desc, published_at desc"}}
                {{#if posts}}
                    <div class="stories-grid" id="stories-grid">
                        {{#foreach posts}}
                        <article class="story-card{{#if featured}} story-card--featured{{/if}}"
                                 data-tags="{{#foreach tags}}{{slug}},{{/foreach}}"
                                 data-animate="fade-up"
                                 data-delay-index="{{@index}}">

                            {{#if featured}}
                            <div class="story-card-badge">Featured</div>
                            {{/if}}

                            {{!-- Cover Image --}}
                            {{#if feature_image}}
                            <a href="{{url}}" class="story-card-image-wrap">
                                <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="story-card-img" loading="lazy">
                                <div class="story-card-img-overlay"></div>
                            </a>
                            {{/if}}

                            <div class="story-card-body">
                                {{!-- Category label from primary tag --}}
                                <div class="story-card-category">
                                    <span class="story-cat-icon">
                                        {{#primary_tag}}
                                            {{#has slug="education"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>{{/has}}
                                            {{#has slug="tribal"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="12 2 2 22 22 22"/></svg>{{/has}}
                                            {{#has slug="women"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>{{/has}}
                                            {{#has slug="health"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>{{/has}}
                                            {{#has slug="posh"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>{{/has}}
                                            {{#has slug="migration"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>{{/has}}
                                            {{#has slug="livelihood"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>{{/has}}
                                        {{/primary_tag}}
                                    </span>
                                    <span class="story-cat-label">{{#primary_tag}}{{name}}{{/primary_tag}}</span>
                                </div>

                                {{!-- Title & Excerpt --}}
                                <h3 class="story-card-title">
                                    <a href="{{url}}">{{title}}</a>
                                </h3>
                                <p class="story-card-excerpt">{{excerpt words="30"}}</p>

                                {{!-- Impact Numbers (stored in Twitter OG meta fields) --}}
                                {{#if twitter_title}}
                                <div class="story-card-impact">
                                    <div class="story-impact-item">
                                        <span class="story-impact-num">{{twitter_title}}</span>
                                        <span class="story-impact-label">{{twitter_description}}</span>
                                    </div>
                                    {{#if og_title}}
                                    <div class="story-impact-item">
                                        <span class="story-impact-num">{{og_title}}</span>
                                        <span class="story-impact-label">{{og_description}}</span>
                                    </div>
                                    {{/if}}
                                </div>
                                {{/if}}

                                {{!-- Tag pills --}}
                                <div class="story-tag-pills">
                                    {{#foreach tags visibility="public"}}
                                    <span class="story-tag-pill">{{name}}</span>
                                    {{/foreach}}
                                </div>

                                {{!-- CTA: links to the actual post --}}
                                <a href="{{url}}" class="story-read-more">
                                    Read Full Story
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                            </div>
                        </article>
                        {{/foreach}}
                    </div>

                {{else}}
                    {{!-- Empty state --}}
                    <div class="stories-empty" data-animate="fade-up">
                        <div class="stories-empty-icon">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h3>Stories Coming Soon</h3>
                        <p>Our team is documenting impact from the field. Check back soon for stories of change from Tamil Nadu's communities.</p>
                        <a href="/" class="story-read-more">Back to Home <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
                    </div>
                {{/if}}

            {{/get}}

            {{!-- No-results state (shown by JS when filter has 0 matches) --}}
            <div class="stories-no-results" id="stories-no-results" style="display:none;" aria-live="polite">
                <p>No stories found for this category yet.</p>
            </div>
        </div>
    </section>

    {{!-- ── Programs Banner (dynamic from tags) ──── --}}
    <section class="stories-programs-banner">
        <div class="stories-container">
            <div class="stories-section-head" data-animate="fade-up">
                <div class="stories-section-label">Programs Behind These Stories</div>
                <h2 class="stories-section-title">Driving Change through <em>Action</em></h2>
            </div>
            <div class="stories-programs-grid">
                {{#get "tags" filter="slug:[education,tribal,women,health,posh,migration,livelihood]" limit="20" order="name asc"}}
                    {{#foreach tags}}
                    <div class="stories-program-pill" data-animate="fade-up" data-delay-index="{{@index}}">
                        <span class="stories-pill-icon"></span>
                        <span class="stories-pill-text">{{name}}</span>
                        {{#if count.posts}}<span class="stories-pill-count">{{count.posts}}</span>{{/if}}
                    </div>
                    {{/foreach}}
                {{/get}}
            </div>
        </div>
    </section>

</div>

<script>
(function() {

    // ── Background Slideshow ──────────────────────────
    var slides = document.querySelectorAll('.hero-slide');
    if (slides.length > 1) {
        var currentSlide = 0;
        setInterval(function() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }, 4000);
    }

    // ── Category Filter ───────────────────────────────
    var filterBtns = document.querySelectorAll('.stories-filter-btn');
    var cards      = document.querySelectorAll('.story-card');
    var noResults  = document.getElementById('stories-no-results');

    if (!filterBtns.length) return;

    filterBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {

            // Update active button
            filterBtns.forEach(function(b) { b.classList.remove('stories-filter-btn--active'); });
            btn.classList.add('stories-filter-btn--active');

            var filter = btn.dataset.filter;
            var visibleCount = 0;

            cards.forEach(function(card) {
                var tagList = (card.dataset.tags || '').split(',').map(function(t){ return t.trim(); });
                var matches = (filter === 'all') || tagList.includes(filter);

                if (matches) {
                    card.style.display = '';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                    visibleCount++;
                } else {
                    card.style.opacity  = '0';
                    card.style.transform = 'translateY(16px)';
                    setTimeout(function(c){ return function(){ c.style.display = 'none'; }; }(card), 280);
                }
            });

            // Show / hide no-results message
            if (noResults) {
                noResults.style.display = visibleCount === 0 ? 'block' : 'none';
            }
        });
    });

})();
</script>

{{/post}}
