<script>
(function() {
    // Category filter
    var filterBtns = document.querySelectorAll('.stories-filter-btn');
    var cards = document.querySelectorAll('.story-card');

    if (filterBtns.length) {
        filterBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                filterBtns.forEach(function(b) { b.classList.remove('stories-filter-btn--active'); });
                btn.classList.add('stories-filter-btn--active');
                var filter = btn.dataset.filter;
                cards.forEach(function(card) {
                    if (filter === 'all' || card.dataset.category === filter) {
                        card.style.display = '';
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    } else {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                        setTimeout(function() { card.style.display = 'none'; }, 300);
                    }
                });
            });
        });
    }

    // Expandable stories
    var readMoreBtns = document.querySelectorAll('.story-read-more');
    readMoreBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var storyId = btn.dataset.story;
            var content = document.getElementById(storyId);
            if (!content) return;
            var isOpen = content.classList.contains('story-full-content--open');
            if (isOpen) {
                content.classList.remove('story-full-content--open');
                content.style.maxHeight = '0';
                btn.innerHTML = 'Read Full Story <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
            } else {
                content.classList.add('story-full-content--open');
                content.style.maxHeight = content.scrollHeight + 'px';
                btn.innerHTML = 'Collapse <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 19l7-7-7-7"/></svg>';
            }
        });
    });

    // Background Slideshow
    var slides = document.querySelectorAll('.hero-slide');
    if (slides.length) {
        var currentSlide = 0;
        setInterval(function() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }, 4000);
    }
})();
</script>

