{{!< default}}

<div class="tag-page">
    <header class="tag-header" data-animate="fade-up">
        <div class="tag-header-inner">
            {{#tag}}
            <div class="tag-icon-wrap">
                {{#if feature_image}}
                <img src="{{img_url feature_image size="xs"}}" alt="{{name}}" class="tag-icon-img">
                {{else}}
                <span class="tag-icon-default"></span>
                {{/if}}
            </div>
            <h1 class="tag-title">{{name}}</h1>
            {{#if description}}
            <p class="tag-desc">{{description}}</p>
            {{/if}}
            <div class="tag-count">{{plural count.posts empty="0 Posts" singular="1 Post" plural="% Posts"}}</div>
            {{/tag}}
        </div>
    </header>

    <div class="tag-posts-wrap">
        <div class="posts-grid">
            {{#foreach posts}}
            <article class="post-card" data-animate="fade-up" data-delay-index="{{@index}}" data-delay-step="80">
                {{#if feature_image}}
                <a href="{{url}}" class="post-card-img-wrap" aria-label="{{title}}">
                    <div class="post-card-img" style="background-image: url({{img_url feature_image size="m"}})">
                        <div class="post-card-img-overlay"></div>
                        {{#primary_tag}}
                        <span class="post-card-tag-badge">{{name}}</span>
                        {{/primary_tag}}
                    </div>
                </a>
                {{/if}}
                <div class="post-card-body">
                    {{#unless feature_image}}
                    {{#primary_tag}}<a href="{{url}}" class="post-card-tag-pill">{{name}}</a>{{/primary_tag}}
                    {{/unless}}
                    <h3 class="post-card-title"><a href="{{url}}">{{title}}</a></h3>
                    <p class="post-card-excerpt post-card-excerpt-short">{{excerpt words="18"}}</p>
                    <div class="post-card-footer">
                        <div class="meta-details">
                            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
                            <span class="meta-dot">·</span>
                            <span>{{reading_time}}</span>
                        </div>
                        <a href="{{url}}" class="post-card-read-link">Read <span>→</span></a>
                    </div>
                </div>
            </article>
            {{/foreach}}
        </div>

        {{pagination}}
    </div>
</div>
