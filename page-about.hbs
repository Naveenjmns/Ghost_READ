{{!< default}}

{{#post}}
<div class="about-page">

    {{!-- ── Hero ─────────────────────────────── --}}
    <section class="about-hero">
        <div class="about-hero-bg">
            <div class="about-hero-orb about-hero-orb-1"></div>
            <div class="about-hero-orb about-hero-orb-2"></div>
            <div class="about-hero-grid"></div>
            
            {{!-- Background Slideshow --}}
            {{#get "posts" filter="tag:hash-about-gallery" limit="6"}}
                {{#if posts}}
                    <div class="hero-slideshow">
                        {{#foreach posts}}
                            <div class="hero-slide{{#if @first}} active{{/if}}" style="background-image: url('{{img_url feature_image size="xl"}}');"></div>
                        {{/foreach}}
                    </div>
                {{else}}
                    <div class="hero-slideshow">
                        <div class="hero-slide active" style="background-image: url('/content/images/Individual Photos/024788ed-0d39-4cc7-b514-4147553f745a.jpg');"></div>
                        <div class="hero-slide" style="background-image: url('/content/images/National days celebration/20251011_170733.jpg');"></div>
                        <div class="hero-slide" style="background-image: url('/content/images/tribal/IMG_2987.JPG');"></div>
                        <div class="hero-slide" style="background-image: url('/content/images/Marathon/DSCF0128.JPG');"></div>
                        <div class="hero-slide" style="background-image: url('/content/images/medical camp - migrants/DSCF0075.JPG');"></div>
                        <div class="hero-slide" style="background-image: url('/content/images/medical camp - migrants/DSCF0074.JPG');"></div>
                    </div>
                {{/if}}
            {{/get}}
            <div class="hero-slideshow-overlay"></div>
        </div>
        <div class="about-hero-inner">
            <div class="about-hero-badge" data-animate="fade-up">
                <span class="about-hero-dot"></span>
                <span>Est. 2001 · Erode, Tamil Nadu</span>
            </div>
            <h1 class="about-hero-title" data-animate="fade-up" data-delay="100">
                {{#if title}}{{title}}{{else}}The <em>READ</em> Story{{/if}}
            </h1>
            <p class="about-hero-subtitle" data-animate="fade-up" data-delay="200">
                Rights Education and Development Centre
            </p>
            <p class="about-hero-desc" data-animate="fade-up" data-delay="300">
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}Over two decades of empowering vulnerable communities through education, rights, and dignity.{{/if}}
            </p>
            <div class="about-hero-stats" data-animate="fade-up" data-delay="400">
                <div class="about-stat">
                    <span class="about-stat-num"><span class="count-up" data-target="20">0</span>+</span>
                    <span class="about-stat-label">Years of Service</span>
                </div>
                <div class="about-stat">
                    <span class="about-stat-num"><span class="count-up" data-target="50000">0</span>+</span>
                    <span class="about-stat-label">Lives Impacted</span>
                </div>
                <div class="about-stat">
                    <span class="about-stat-num"><span class="count-up" data-target="12">0</span>+</span>
                    <span class="about-stat-label">Programs</span>
                </div>
                <div class="about-stat">
                    <span class="about-stat-num">Tamil Nadu</span>
                    <span class="about-stat-label">Region Served</span>
                </div>
            </div>
        </div>
    </section>

    {{!-- ── Founding Story ──────────────────── --}}
    <section class="about-story">
        <div class="about-container">
            <div class="about-story-grid">
                <div class="about-story-text" data-animate="fade-up">
                    <div class="about-section-label">Our Founding</div>
                    <h2 class="about-section-title">Born from a belief that <em>education changes everything</em></h2>
                    <div class="about-story-body gh-content">
                        {{content}}
                    </div>
                </div>
                <div class="about-story-visual" data-animate="fade-up" data-delay="150">
                    {{#get "posts" filter="tag:about-founder" limit="1" include="tags"}}
                        {{#if posts}}
                            {{#foreach posts}}
                                <div class="about-founder-card">
                                    {{#if feature_image}}
                                        <div class="about-founder-avatar" style="background-image: url('{{img_url feature_image size="s"}}'); width: 64px; height: 64px; border-radius: 50%; background-size: cover; background-position: center; border: 2px solid var(--clr-gold); margin-right: 16px;"></div>
                                    {{else}}
                                        <div class="about-founder-icon"></div>
                                    {{/if}}
                                    <div class="about-founder-body">
                                        <div class="about-founder-label">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}Founder{{/if}}</div>
                                        <div class="about-founder-name">{{title}}</div>
                                        <div class="about-founder-year">{{#if meta_title}}{{meta_title}}{{else}}Since 2001{{/if}}</div>
                                    </div>
                                </div>
                                <div class="about-story-quote">
                                    <svg class="about-quote-mark" width="40" height="32" viewBox="0 0 40 32" fill="none"><path d="M0 32V19.2C0 8.533 5.333 2.4 16 0l2.4 4C13.067 5.6 10.4 8.8 10.4 13.6V16H18V32H0ZM22 32V19.2C22 8.533 27.333 2.4 38 0l2.4 4C35.067 5.6 32.4 8.8 32.4 13.6V16H40V32H22Z" fill="currentColor"/></svg>
                                    <p>{{content}}</p>
                                    <div class="about-quote-attr">— READ's Founding Vision</div>
                                </div>
                            {{/foreach}}
                        {{/if}}
                    {{/get}}
                </div>
            </div>
        </div>
    </section>



    {{!-- ── Journey Timeline ────────────────── --}}
    {{#get "posts" filter="tag:about-journey" limit="99" order="published_at asc" include="tags"}}
        {{#if posts}}
            <section class="about-timeline">
                <div class="about-container">
                    <div class="about-section-head" data-animate="fade-up">
                        <div class="about-section-label">Our Journey</div>
                        <h2 class="about-section-title">Two Decades of <em>Impact</em></h2>
                    </div>
                    <div class="about-timeline-track">
                        <div class="about-timeline-line"></div>
                        {{#foreach posts}}
                            <div class="about-timeline-item{{#if @odd}} about-timeline-item--right{{/if}}" data-animate="fade-up">
                                <div class="about-timeline-dot{{#if @last}} about-timeline-dot--active{{/if}}"></div>
                                <div class="about-timeline-content">
                                    <h4>{{title}}</h4>
                                    <div>{{content}}</div>
                                </div>
                            </div>
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/if}}
    {{/get}}

    {{!-- ── Programs ─────────────────────────── --}}
    {{#get "posts" filter="tag:about-program" limit="99" order="published_at asc" include="tags"}}
        {{#if posts}}
            <section class="about-programs">
                <div class="about-container">
                    <div class="about-section-head" data-animate="fade-up">
                        <div class="about-section-label">What We Do</div>
                        <h2 class="about-section-title">Our <em>Programs</em></h2>
                    </div>
                    <div class="about-programs-grid">
                        {{#foreach posts}}
                            <div class="about-program-card" data-animate="fade-up" data-delay-index="{{@index}}">
                                <div class="about-program-img-wrap">
                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                                    {{else}}
                                        <div style="width: 100%; height: 100%; background: var(--clr-bg-2);"></div>
                                    {{/if}}
                                </div>
                                <span class="about-program-icon">
                                    {{#has tag="education"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>{{else}}
                                    {{#has tag="livelihood"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>{{else}}
                                    {{#has tag="tribal"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="12 2 2 22 22 22"></polygon></svg>{{else}}
                                    {{#has tag="migration"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>{{else}}
                                    {{#has tag="women"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>{{else}}
                                    {{#has tag="health"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>{{else}}
                                    {{#has tag="welfare"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>{{else}}
                                    {{#has tag="posh"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>{{else}}
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                                    {{/has}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}
                                </span>
                                <h4 class="about-program-title">{{title}}</h4>
                                <p class="about-program-desc">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt}}{{/if}}</p>
                            </div>
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/if}}
    {{/get}}




    {{!-- ── Partners & Collaborators ────────── --}}
    <section class="about-partners" data-animate="fade-up">
        <div class="about-container">
            <div class="about-section-head" data-animate="fade-up">
                <div class="about-section-label">Partnerships</div>
                <h2 class="about-section-title">Our <em>Partners</em> & Collaborators</h2>
            </div>
            
            <div class="partners-grid-wrapper">
                {{!-- General/Corporate Partners --}}
                <div class="partners-block" data-animate="fade-up" data-delay="100">
                    <h3 class="partners-block-title">Government & Corporate Partners</h3>
                    <div class="partners-list-tags">
                        <span class="partner-tag">Missorium</span>
                        <span class="partner-tag">DTH</span>
                        <span class="partner-tag">Versuni</span>
                        <span class="partner-tag">o9 Solution</span>
                        <span class="partner-tag">Labour Department</span>
                        <span class="partner-tag">NSNOP department</span>
                    </div>
                </div>

                {{!-- Institutional Partners --}}
                <div class="partners-block" data-animate="fade-up" data-delay="200">
                    <h3 class="partners-block-title">Institutional Partners</h3>
                    <div class="partners-list-tags">
                        <span class="partner-tag">The VET Institute of Arts and Science (VETIAS) in Erode</span>
                        <span class="partner-tag">JKKM Institutions</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- ── Closing Quote ────────────────────── --}}
    <section class="about-closing">
        <div class="about-closing-bg"></div>
        <div class="about-container">
            <div class="about-closing-inner" data-animate="fade-up">
                <div class="about-closing-logo">
                    <img src="{{#if @site.logo}}{{@site.logo}}{{else}}{{asset "img/read-logo.png"}}{{/if}}" alt="READ Logo" width="80" height="80">
                </div>
                <blockquote class="about-closing-quote">
                    Education brings dignity.<br>
                    Education creates opportunity.<br>
                    Education builds equality.
                </blockquote>
                <p class="about-closing-sub">With this vision, READ remains committed to building empowered, inclusive, and self-reliant communities across Tamil Nadu.</p>
                <div class="about-closing-actions">
                    <a href="/donate-us/" class="about-cta-btn about-cta-btn--primary">Support Our Work</a>
                    <a href="/conatct-us/" class="about-cta-btn about-cta-btn--outline">Contact Us</a>
                </div>
            </div>
        </div>
    </section>

</div>

<script>
(function() {
    // Background Slideshow
    var slides = document.querySelectorAll('.about-hero .hero-slide');
    if (slides.length) {
        var currentSlide = 0;
        setInterval(function() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }, 4000);
    }
})();
</script>
{{/post}}
