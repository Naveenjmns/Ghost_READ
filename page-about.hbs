{{!< default}}

{{#post}}
<div class="about-page">

    {{!-- ── Hero ─────────────────────────────── --}}
    {{!-- ── Hero Section (Home page style) ── --}}
    <section class="about-hero-section">
        {{!-- Top Image Banner Slideshow --}}
        <div class="hero-image-banner">
            <div class="hero-slideshow" id="about-hero-slideshow" style="opacity: 1;">
                <div class="hero-slide active" style="background-image: url('{{asset "img/about1.png"}}');"></div>
                <div class="hero-slide" style="background-image: url('{{asset "img/about2.png"}}');"></div>
                <div class="hero-slide" style="background-image: url('{{asset "img/about3.jpg.jpeg"}}');"></div>
            </div>
        </div>

        {{!-- Dynamic Slider content post tagged #about-slider --}}
        {{#get "posts" filter="tag:hash-about-slider" limit="1" as |slider_post|}}
            {{#if slider_post}}
                {{#foreach slider_post}}
                    <div id="about-slider-raw-content" style="display: none;">{{content}}</div>
                {{/foreach}}
            {{/if}}
        {{/get}}

        {{!-- Bottom Text Content (solid background matching home hero styling) --}}
        <div class="hero-text-content">
            <div class="about-hero-inner">
                <div class="about-hero-badge" data-animate="fade-up">
                    <span class="about-hero-dot"></span>
                    <span>Est. 2001 · Erode, Tamil Nadu</span>
                </div>

                <div class="about-hero-kicker" data-animate="fade-up" data-delay="60">
                    <span class="about-hero-kicker-line"></span>
                    <span class="about-hero-kicker-text">Rights Education and Development Centre</span>
                    <span class="about-hero-kicker-line"></span>
                </div>

                <h1 class="about-hero-title" data-animate="fade-up" data-delay="120">
                    {{#if title}}{{title}}{{else}}The <em>READ</em> Story{{/if}}
                </h1>

                <p class="about-hero-desc" data-animate="fade-up" data-delay="220">
                    {{#if custom_excerpt}}{{custom_excerpt}}{{else}}Over <strong>two decades</strong> of empowering <em>vulnerable communities</em> through education, rights, and dignity.{{/if}}
                </p>

                <div class="about-hero-pills" data-animate="fade-up" data-delay="300">
                    <span class="about-hero-pill">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        Education
                    </span>
                    <span class="about-hero-pill">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                        Rights
                    </span>
                    <span class="about-hero-pill">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        Dignity
                    </span>
                    <span class="about-hero-pill">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        Health
                    </span>
                    <span class="about-hero-pill">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                        Livelihood
                    </span>
                </div>

                <div class="about-hero-stats" id="about-hero-stats" data-animate="fade-up" data-delay="400">
                    <div class="about-stat">
                        <span class="about-stat-num" id="about-stat-years" data-stat-value="20+">20+</span>
                        <span class="about-stat-label">Years of Service</span>
                    </div>
                    <div class="about-stat">
                        <span class="about-stat-num" id="about-stat-lives" data-stat-value="50000+">50000+</span>
                        <span class="about-stat-label">Lives Impacted</span>
                    </div>
                    <div class="about-stat">
                        <span class="about-stat-num" id="about-stat-programs" data-stat-value="12+">12+</span>
                        <span class="about-stat-label">Programs</span>
                    </div>
                    <div class="about-stat">
                        <span class="about-stat-num" id="about-stat-region">Tamil Nadu</span>
                        <span class="about-stat-label">Region Served</span>
                    </div>
                </div>

                {{#if @custom.about_stats}}
                <script>
                (function() {
                    const rawStats = "{{@custom.about_stats}}".trim();
                    if (!rawStats) return;

                    const parts = rawStats.split(',').map(p => p.trim());
                    
                    const years = parts[0] || '20+';
                    const lives = parts[1] || '50000+';
                    const programs = parts[2] || '12+';
                    const region = parts[3] || 'Tamil Nadu';

                    const yearsEl = document.getElementById('about-stat-years');
                    const livesEl = document.getElementById('about-stat-lives');
                    const programsEl = document.getElementById('about-stat-programs');
                    const regionEl = document.getElementById('about-stat-region');

                    if (yearsEl) {
                        yearsEl.textContent = years;
                        yearsEl.setAttribute('data-stat-value', years);
                    }
                    if (livesEl) {
                        livesEl.textContent = lives;
                        livesEl.setAttribute('data-stat-value', lives);
                    }
                    if (programsEl) {
                        programsEl.textContent = programs;
                        programsEl.setAttribute('data-stat-value', programs);
                    }
                    if (regionEl) {
                        regionEl.textContent = region;
                    }
                })();
                </script>
                {{/if}}
            </div>
        </div>
    </section>

    {{!-- ── Founding Story ──────────────────── --}}
    <section class="about-story">
        <div class="about-container">
            <div class="about-story-grid">
                <div class="about-story-text" data-animate="fade-up">
                    <div class="about-section-label">Our Founding</div>
                    <h2 class="about-section-title">Born from a belief that <em>education changes everything</em></h2>
                    <div class="about-story-body gh-content">
                        {{content}}
                    </div>
                </div>
                <div class="about-story-visual" data-animate="fade-up" data-delay="150">
                    {{#get "posts" filter="tag:about-founder" limit="1" include="tags"}}
                        {{#if posts}}
                            {{#foreach posts}}
                                <div class="about-founder-card">
                                    {{#if feature_image}}
                                        <div class="about-founder-avatar" style="background-image: url('{{img_url feature_image size="s"}}'); width: 64px; height: 64px; border-radius: 50%; background-size: cover; background-position: center; border: 2px solid var(--clr-gold); margin-right: 16px;"></div>
                                    {{else}}
                                        <div class="about-founder-icon"></div>
                                    {{/if}}
                                    <div class="about-founder-body">
                                        <div class="about-founder-label">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}Founder{{/if}}</div>
                                        <div class="about-founder-name">{{title}}</div>
                                        <div class="about-founder-year">{{#if meta_title}}{{meta_title}}{{else}}Since 2001{{/if}}</div>
                                    </div>
                                </div>
                                <div class="about-story-quote">
                                    <svg class="about-quote-mark" width="40" height="32" viewBox="0 0 40 32" fill="none"><path d="M0 32V19.2C0 8.533 5.333 2.4 16 0l2.4 4C13.067 5.6 10.4 8.8 10.4 13.6V16H18V32H0ZM22 32V19.2C22 8.533 27.333 2.4 38 0l2.4 4C35.067 5.6 32.4 8.8 32.4 13.6V16H40V32H22Z" fill="currentColor"/></svg>
                                    <p>{{content}}</p>
                                    <div class="about-quote-attr">— READ's Founding Vision</div>
                                </div>
                            {{/foreach}}
                        {{/if}}
                    {{/get}}
                </div>
            </div>
        </div>
    </section>



    {{!-- ── Mission Section ─────────────────── --}}
    <section class="about-mission">
        <div class="about-container">
            {{#get "posts" filter="tag:hash-about-mission" limit="1" include="tags"}}
                {{#if posts}}
                    {{#foreach posts}}
                        <div class="about-mission-block" data-animate="fade-up">
                            <div class="about-section-label">Our Mission</div>
                            <div class="about-mission-text gh-content">
                                {{content}}
                            </div>
                            {{#if tags}}
                                <div class="about-mission-chips">
                                    {{#foreach tags}}
                                        {{#if visibility}}
                                            <span class="about-mission-chip">
                                                {{#has slug="education"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>{{else}}
                                                {{#has slug="health"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>{{else}}
                                                {{#has slug="livelihood"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>{{else}}
                                                {{#has slug="rights"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>{{/has}}{{/has}}{{/has}}{{/has}}
                                                {{name}}
                                            </span>
                                        {{/if}}
                                    {{/foreach}}
                                </div>
                            {{/if}}
                        </div>
                    {{/foreach}}
                {{else}}
                    {{!-- Default Fallback --}}
                    <div class="about-mission-block" data-animate="fade-up">
                        <div class="about-section-label">Our Mission</div>
                        <div class="about-mission-text gh-content">
                            <p>We address socio-economic challenges for <strong>children, youth, and women</strong> from marginalized communities by improving <strong>education, health, livelihood opportunities,</strong> and access to rights.</p>
                        </div>
                        <div class="about-mission-chips">
                            <span class="about-mission-chip">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                                Education
                            </span>
                            <span class="about-mission-chip">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                                Health
                            </span>
                            <span class="about-mission-chip">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                                Livelihood
                            </span>
                            <span class="about-mission-chip">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                                Rights
                            </span>
                        </div>
                    </div>
                {{/if}}
            {{/get}}
        </div>
    </section>



    {{!-- ── Journey Timeline ────────────────── --}}
    {{#get "posts" filter="tag:about-journey" limit="99" order="published_at asc" include="tags"}}
        {{#if posts}}
            <section class="about-timeline">
                <div class="about-container">
                    <div class="about-section-head" data-animate="fade-up">
                        <div class="about-section-label">Our Journey</div>
                        <h2 class="about-section-title">Celebrating 25 Years of <em>Impact</em></h2>
                    </div>
                    <div class="about-timeline-track">
                        <div class="about-timeline-line"></div>
                        {{#foreach posts}}
                            <div class="about-timeline-item{{#if @odd}} about-timeline-item--right{{/if}}" data-animate="fade-up">
                                <div class="about-timeline-dot{{#if @last}} about-timeline-dot--active{{/if}}"></div>
                                <div class="about-timeline-year{{#if @last}} about-timeline-year--active{{/if}}">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{date published_at format="YYYY"}}{{/if}}</div>
                                <div class="about-timeline-content">
                                    <h4>{{title}}</h4>
                                    <div>{{content}}</div>
                                </div>
                            </div>
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/if}}
    {{/get}}

    {{!-- ── Programs ─────────────────────────── --}}
    {{#get "posts" filter="tag:about-program" limit="99" order="published_at asc" include="tags"}}
        {{#if posts}}
            <section class="about-programs">
                <div class="about-container">
                    <div class="about-section-head" data-animate="fade-up">
                        <div class="about-section-label">What We Do</div>
                        <h2 class="about-section-title">Our <em>Programs</em></h2>
                    </div>
                    <div class="about-programs-grid">
                        {{#foreach posts}}
                            <div class="about-program-card" data-animate="fade-up" data-delay-index="{{@index}}">
                                <div class="about-program-img-wrap">
                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                                    {{else}}
                                        <div style="width: 100%; height: 100%; background: var(--clr-bg-2);"></div>
                                    {{/if}}
                                </div>
                                <span class="about-program-icon">
                                    {{#has tag="education"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>{{else}}
                                    {{#has tag="livelihood"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>{{else}}
                                    {{#has tag="tribal"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="12 2 2 22 22 22"></polygon></svg>{{else}}
                                    {{#has tag="migration"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>{{else}}
                                    {{#has tag="women"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>{{else}}
                                    {{#has tag="health"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>{{else}}
                                    {{#has tag="welfare"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>{{else}}
                                    {{#has tag="posh"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>{{else}}
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                                    {{/has}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}
                                </span>
                                <h4 class="about-program-title">{{title}}</h4>
                                <p class="about-program-desc">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt}}{{/if}}</p>
                            </div>
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/if}}
    {{/get}}






    {{!-- ── Closing Quote ────────────────────── --}}
    <section class="about-closing">
        <div class="about-closing-bg"></div>
        <div class="about-container">
            <div class="about-closing-inner" data-animate="fade-up">
                <div class="about-closing-logo">
                    {{#get "posts" filter="tag:hash-custom-logo" limit="1" as |logo_post|}}
                        {{#if logo_post}}
                            {{#foreach logo_post}}
                                <img src="{{img_url feature_image}}" alt="READ Logo" width="80" height="80">
                            {{/foreach}}
                        {{else}}
                            <img src="{{#if @site.logo}}{{@site.logo}}{{else}}{{asset "img/read-logo.png"}}{{/if}}" alt="READ Logo" width="80" height="80">
                        {{/if}}
                    {{/get}}
                </div>
                <blockquote class="about-closing-quote">
                    Education brings dignity.<br>
                    Education creates opportunity.<br>
                    Education builds equality.
                </blockquote>
                <p class="about-closing-sub">With this vision, READ remains committed to building empowered, inclusive, and self-reliant communities across Tamil Nadu.</p>
                <div class="about-closing-actions">
                    <a href="/donate-us/" class="about-cta-btn about-cta-btn--primary">Support Our Work</a>
                    <a href="/contact-us/" class="about-cta-btn about-cta-btn--outline">Contact Us</a>
                </div>
            </div>
        </div>
    </section>

</div>

<script>
(function() {
    const rawContentEl = document.getElementById('about-slider-raw-content');
    const sliderContainer = document.getElementById('about-hero-slideshow');
    
    if (rawContentEl && sliderContainer) {
        const imgs = rawContentEl.querySelectorAll('img');
        const imgUrls = Array.from(imgs).map(img => img.src || img.getAttribute('src')).filter(Boolean);
        
        if (imgUrls.length > 0) {
            // Clear fallback slides
            sliderContainer.innerHTML = '';
            
            // Generate dynamic slides
            imgUrls.forEach((url, index) => {
                const slide = document.createElement('div');
                slide.className = 'hero-slide' + (index === 0 ? ' active' : '');
                slide.style.backgroundImage = `url('${url}')`;
                sliderContainer.appendChild(slide);
            });
        }
    }
    
    // Background Slideshow transition
    const slides = sliderContainer ? sliderContainer.querySelectorAll('.hero-slide') : [];
    if (slides.length > 1) {
        let currentSlide = 0;
        setInterval(function() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }, 4000);
    }
})();
</script>
{{/post}}
