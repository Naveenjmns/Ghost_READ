{
  "name": "read",
  "description": "READ — A Premium Literary & Personal Blog Ghost Theme",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "READ Centre",
    "email": "info@readcentre.org"
  },
  "keywords": [
    "ghost-theme",
    "blog",
    "reading",
    "literature",
    "personal",
    "editorial"
  ],
  "config": {
    "posts_per_page": 9,
    "image_sizes": {
      "xxs": { "width": 30 },
      "xs": { "width": 100 },
      "s": { "width": 300 },
      "m": { "width": 600 },
      "l": { "width": 1000 },
      "xl": { "width": 2000 }
    },
    "card_assets": true,
    "custom": {
      "about_slide_1": {
        "type": "image"
      },
      "about_slide_2": {
        "type": "image"
      },
      "about_slide_3": {
        "type": "image"
      },
      "about_slide_4": {
        "type": "image"
      },
      "about_slide_5": {
        "type": "image"
      },
      "about_slide_6": {
        "type": "image"
      },
      "stories_slide_1": {
        "type": "image"
      },
      "stories_slide_2": {
        "type": "image"
      },
      "stories_slide_3": {
        "type": "image"
      },
      "stories_slide_4": {
        "type": "image"
      },
      "stories_slide_5": {
        "type": "image"
      },
      "stories_slide_6": {
        "type": "image"
      },
      "homepage_hero_image": {
        "type": "image"
      },
      "silver_jubilee_image": {
