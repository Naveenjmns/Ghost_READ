{{!< default}}

{{!-- HERO / VISION & MISSION --}}
<section class="home-hero" id="home-hero">
    <div class="hero-backdrop">
        <div class="hero-texture"></div>
    </div>
    <div class="hero-container">

        {{!-- Hero Left: Vision & Mission --}}
        <div class="hero-masthead" data-animate="fade-right">
            <div class="masthead-edition">
                <span class="edition-label">Rights Education and Development Centre</span>
            </div>
            
            <div class="vision-block">
                <h1 class="vision-text">
                    Creating a society where every person has the right to a good standard of living and human dignity.
                </h1>
            </div>

            <div class="mission-block">
                <p class="mission-text">
                    We address socio-economic challenges for children, youth, and women from marginalized communities by improving education, health, livelihood opportunities, and access to rights.
                </p>
            </div>

            <div class="masthead-actions">
                <a href="#what-we-do" class="btn-primary-read">Our Programs</a>
            </div>
        </div>

        {{!-- Hero Right: Who We Are --}}
        <div class="hero-featured who-we-are-card" data-animate="fade-left">
            <div class="who-we-are-image-wrap">
                <img src="{{asset "interstate-migrant-workers.jpg"}}" alt="Interstate Migrant workers group meeting" class="who-we-are-img" width="550" height="240">
            </div>
            <div class="hero-featured-label">
                <span class="pen-nib">✦</span> At a Glance
            </div>
            <div class="hero-featured-body">
                <h2 class="hero-featured-title">Empowering Communities, Restoring Dignity</h2>
                <p class="hero-featured-excerpt">
                    READ is a registered non-governmental organization working with vulnerable and marginalized communities across Tamil Nadu. We focus on tribal development, safe migration support, POSH Act implementation, and sanitary workers' welfare.
                </p>
                
                <div class="credentials-badges">
                    <span class="cred-badge" title="Registered under Societies Act">Societies Act</span>
                    <span class="cred-badge" title="Income Tax Exemption 12A Status">IT 12A</span>
                    <span class="cred-badge" title="Tax Deduction 80G Status">80G</span>
                    <span class="cred-badge" title="NGO Darpan Registered">NGO Darpan</span>
                    <span class="cred-badge" title="CSR Registered CSR00002307">CSR Regd.</span>
                </div>
            </div>
        </div>
        
    </div>
</section>

{{!-- WHAT WE DO --}}
<section class="programs-section" id="what-we-do">
    <div class="programs-container">
        
        <div class="section-header" data-animate="fade-up">
            <div class="section-header-line"></div>
            <h2 class="section-title">What We <em>Do</em></h2>
            <div class="section-header-line"></div>
        </div>

        <div class="programs-list">
            
            {{!-- Card 1: Tribal Development --}}
            <div class="program-horizontal-card" data-animate="fade-up">
                <div class="program-image-wrap">
                    <img src="{{asset "tribal-development.jpg"}}" alt="Tribal Community Holistic Development" class="program-img" width="550" height="350">
                </div>
                <div class="program-content">
                    <div class="program-header-row">
                        <span class="program-icon-badge">🌳</span>
                        <span class="program-region-tag">Sathyamangalam Tiger Reserve</span>
                    </div>
                    <h3 class="program-title">Tribal Community Holistic Development</h3>
                    <p class="program-desc">
                        Empowering tribal forest communities in the Sathyamangalam Tiger Reserve through educational centers, libraries, solar energy, agricultural sprinkler irrigation, and millet value-addition.
                    </p>
                    <a href="/about-us/" class="program-learn-btn">Explore Program</a>
                </div>
            </div>

            {{!-- Card 2: Sanitary Workers --}}
            <div class="program-horizontal-card" data-animate="fade-up" data-delay="100">
                <div class="program-content">
                    <div class="program-header-row">
                        <span class="program-icon-badge">🧹</span>
                        <span class="program-region-tag">Tamil Nadu Districts</span>
                    </div>
                    <h3 class="program-title">Sanitary Workers Welfare</h3>
                    <p class="program-desc">
                        Addressing health hazards and discrimination for sanitary worker communities through child support centers, educational coaching, medical camps, and legal aid.
                    </p>
                    <a href="/about-us/" class="program-learn-btn">Explore Program</a>
                </div>
                <div class="program-image-wrap">
                    <img src="/content/images/Individual Photos/981e5617-f7c6-4f5c-b188-5375ccf9d618.jpg" alt="Sanitary Workers Welfare" class="program-img" width="550" height="350">
                </div>
            </div>

            {{!-- Card 3: Safe Migration --}}
            <div class="program-horizontal-card" data-animate="fade-up" data-delay="200">
                <div class="program-image-wrap">
                    <img src="/content/images/Individual Photos/9ffe2c50-35ce-46f3-be00-c1d206b5c967.jpg" alt="Safe Migration Support" class="program-img" width="550" height="350">
                </div>
                <div class="program-content">
                    <div class="program-header-row">
                        <span class="program-icon-badge">🚌</span>
                        <span class="program-region-tag">Tirupur, Erode, Dindigul, Namakkal</span>
                    </div>
                    <h3 class="program-title">Safe Migration Support</h3>
                    <p class="program-desc">
                        Supporting interstate migrant families in Tamil Nadu with language-friendly education centers, local school enrollment, healthcare clinics, and social benefits card access.
                    </p>
                    <a href="/about-us/" class="program-learn-btn">Explore Program</a>
                </div>
            </div>

            {{!-- Card 4: POSH Act Implementation --}}
            <div class="program-horizontal-card" data-animate="fade-up" data-delay="300">
                <div class="program-content">
                    <div class="program-header-row">
                        <span class="program-icon-badge">🛡️</span>
                        <span class="program-region-tag">Coimbatore, Tirupur, Erode</span>
                    </div>
                    <h3 class="program-title">Strengthening POSH Act Implementation</h3>
                    <p class="program-desc">
                        Partnering with industries to foster safe, dignified workplaces for women through POSH Internal Complaints Committee (IC) formation, capacity building, and life skills training.
                    </p>
                    <a href="/about-us/" class="program-learn-btn">Explore Program</a>
                </div>
                <div class="program-image-wrap">
                    <img src="/content/images/IC Meeting/WhatsApp Image 2026-05-09 at 12.39.07 PM.jpeg" alt="Strengthening POSH Act Implementation" class="program-img" width="550" height="350">
                </div>
            </div>

            {{!-- Card 5: Entrepreneur Support --}}
            <div class="program-horizontal-card" data-animate="fade-up" data-delay="400">
                <div class="program-image-wrap">
                    <img src="/content/images/National days celebration/20251011_165840.jpg" alt="Entrepreneur Support" class="program-img" width="550" height="350">
                </div>
                <div class="program-content">
                    <div class="program-header-row">
                        <span class="program-icon-badge">💼</span>
                        <span class="program-region-tag">Tamil Nadu, Odisha, Maharashtra</span>
                    </div>
                    <h3 class="program-title">Entrepreneur Support</h3>
                    <p class="program-desc">
                        Promoting economic self-reliance among Dalit and tribal communities through entrepreneurship development training, mentoring, grants, and market linkages for first-generation business owners.
                    </p>
                    <a href="/about-us/" class="program-learn-btn">Explore Program</a>
                </div>
            </div>

            {{!-- Card 6: CSR --}}
            <div class="program-horizontal-card" data-animate="fade-up" data-delay="500">
                <div class="program-content">
                    <div class="program-header-row">
                        <span class="program-icon-badge">🏫</span>
                        <span class="program-region-tag">Multi-Region Schools</span>
                    </div>
                    <h3 class="program-title">Corporate Social Responsibility (CSR)</h3>
                    <p class="program-desc">
                        Upgrading infrastructure at government and community schools to create child-friendly classrooms, modern computer labs, science facilities, and safe sanitation blocks.
                    </p>
                    <a href="/about-us/" class="program-learn-btn">Explore Program</a>
                </div>
                <div class="program-image-wrap">
                    <img src="/content/images/Individual Photos/e6bc3019-a383-4593-9082-1a4246bd5441.jpg" alt="Corporate Social Responsibility" class="program-img" width="550" height="350">
                </div>
            </div>

        </div>
    </div>
</section>


{{!-- IMPACT MOTTO / QUOTE STRIPE --}}
<section class="quote-stripe" data-animate="fade-up">
    <div class="quote-stripe-inner">
        <div class="quote-mark-big">"</div>
        <blockquote class="rotating-quote" id="rotating-quote">
            To create a society where every person has the right to a good standard of living and human dignity.
        </blockquote>
        <cite class="quote-author">— READ Core Vision</cite>
    </div>
</section>

{{!-- JOIN NETWORK / NEWSLETTER --}}
<section class="newsletter-section" id="newsletter" data-animate="fade-up">
    <div class="newsletter-container">
        <div class="newsletter-card">
            <div class="newsletter-left">
                <div class="newsletter-icon"></div>
                <h2 class="newsletter-title">Join the <em>READ Network</em></h2>
                <p class="newsletter-desc">Stay updated on our community projects, tribal development initiatives, health camp schedules, and social advocacy efforts across Tamil Nadu.</p>
                <ul class="newsletter-perks">
                    <li>✦ Project Updates &amp; Impact Reports</li>
                    <li>✦ Voluntarism &amp; CSR opportunities</li>
                    <li>✦ Human Rights advocacy updates</li>
                </ul>
            </div>
            <div class="newsletter-right">
                <form class="newsletter-form" data-members-form="subscribe" id="newsletter-form">
                    <div class="newsletter-form-group">
                        <label for="newsletter-email" class="newsletter-label">Your email address</label>
                        <input
                            id="newsletter-email"
                            type="email"
                            placeholder="yourname@example.com"
                            data-members-email
                            required
                            aria-label="Email address"
                        >
                    </div>
                    <button type="submit" class="btn-primary-read btn-full" id="newsletter-submit">
                        <span class="btn-text">Join the Movement →</span>
                    </button>
                    <p class="newsletter-fine">We value your privacy. Unsubscribe at any time.</p>
                    <div class="newsletter-success" style="display:none;" aria-live="polite">
                        <span></span> Thank you for subscribing to READ! Let's build a dignified society.
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
