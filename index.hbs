{{!< default}}

{{!-- HERO / VISION & MISSION --}}
<section class="home-hero" id="home-hero">
    <div class="hero-backdrop">
        <div class="hero-texture"></div>
    </div>
    <div class="hero-container">

        {{!-- Hero Left: Vision & Mission --}}
        <div class="hero-masthead" data-animate="fade-right">
            <div class="masthead-edition">
                <span class="edition-label">Rights Education and Development Centre</span>
            </div>
            
            <div class="vision-block">
                <h1 class="vision-text">
                    Creating a society where every person has the right to a good standard of living and human dignity.
                </h1>
            </div>

            <div class="mission-block">
                <p class="mission-text">
                    We address socio-economic challenges for children, youth, and women from marginalized communities by improving education, health, livelihood opportunities, and access to rights.
                </p>
            </div>

            <div class="masthead-actions">
                <a href="#what-we-do" class="btn-primary-read">Our Programs</a>
            </div>
        </div>

        {{!-- Hero Right: Who We Are --}}
        <div class="hero-featured who-we-are-card" data-animate="fade-left">
            <div class="who-we-are-image-wrap">
                <img src="{{asset "img/index_READ.jpeg"}}" alt="Interstate Migrant workers group meeting" class="who-we-are-img" width="550" height="240">
            </div>
            <div class="hero-featured-label">
                <span class="pen-nib">✦</span> At a Glance
            </div>
            <div class="hero-featured-body">
                <h2 class="hero-featured-title">Empowering Communities, Restoring Dignity</h2>
                <p class="hero-featured-excerpt">
                    READ is a registered non-governmental organization working with vulnerable and marginalized communities across Tamil Nadu. We focus on tribal development, safe migration support, POSH Act implementation, and sanitary workers' welfare.
                </p>
                
                <div class="credentials-badges">
                    <span class="cred-badge" title="Registered under Societies Act">Societies Act</span>
                    <span class="cred-badge" title="Income Tax Exemption 12A Status">IT 12A</span>
                    <span class="cred-badge" title="Tax Deduction 80G Status">80G</span>
                    <span class="cred-badge" title="NGO Darpan Registered">NGO Darpan</span>
                    <span class="cred-badge" title="CSR Registered CSR00002307">CSR Regd.</span>
                </div>
            </div>
        </div>
        
    </div>
</section>

{{!-- WHAT WE DO --}}
<section class="programs-section" id="what-we-do">
    <div class="programs-container">
        
        <div class="section-header" data-animate="fade-up">
            <div class="section-header-line"></div>
            <h2 class="section-title">What We <em>Do</em></h2>
            <div class="section-header-line"></div>
        </div>

        {{!-- Dynamic: posts tagged with internal tag #program --}}
        {{#get "posts" filter="tag:hash-program" limit="20" order="published_at asc" include="tags"}}
            {{#if posts}}
                <div class="programs-list">
                    {{#foreach posts}}
                        {{!-- Odd = image left, Even = image right --}}
                        <article class="program-horizontal-card{{#if @even}} program-horizontal-card--flip{{/if}}" data-animate="fade-up">

                            <div class="program-image-wrap">
                                {{#if feature_image}}
                                    <img
                                        src="{{img_url feature_image size="m"}}"
                                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                        class="program-img"
                                        width="550"
                                        height="350"
                                        loading="lazy"
                                    >
                                {{else}}
                                    <div class="program-img-placeholder" aria-hidden="true"></div>
                                {{/if}}
                            </div>

                            <div class="program-content">
                                <div class="program-header-row">
                                    {{#if primary_tag}}
                                        <span class="program-region-tag">{{primary_tag.name}}</span>
                                    {{/if}}
                                </div>
                                <h3 class="program-title">{{title}}</h3>
                                <p class="program-desc">{{excerpt}}</p>
                                <a href="{{url}}" class="program-learn-btn">Explore Program</a>
                            </div>

                        </article>
                    {{/foreach}}
                </div>
            {{else}}
                {{!-- No programs published yet --}}
                <p class="programs-empty-note">Programs coming soon. Add posts with the <code>#program</code> tag in Ghost Admin.</p>
            {{/if}}
        {{/get}}
    </div>
</section>


{{!-- IMPACT MOTTO / QUOTE STRIPE --}}
<section class="quote-stripe" data-animate="fade-up">
    <div class="quote-stripe-inner">
        <div class="quote-mark-big">"</div>
        <blockquote class="rotating-quote" id="rotating-quote">
            To create a society where every person has the right to a good standard of living and human dignity.
        </blockquote>
        <cite class="quote-author">— READ Core Vision</cite>
    </div>
</section>


